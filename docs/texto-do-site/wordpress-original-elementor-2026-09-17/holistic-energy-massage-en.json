{"content":[{"id":"7270778f","settings":[],"elements":[{"id":"763bba42","settings":{"editor":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Holistic Energy Massage Amsterdam | Mari Gomes<\/title>\n<link rel=\"preconnect\" href=\"https:\/\/fonts.googleapis.com\">\n<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n  :root {\n    --cream: #F7F3EE;\n    --warm-white: #FDFAF7;\n    --charcoal: #1C1916;\n    --stone: #6B6460;\n    --gold: #B8924A;\n    --gold-light: #D4B07A;\n    --sage: #7A8C7E;\n    --blush: #D4B5A8;\n    --border: rgba(28,25,22,0.1);\n  }\n\n  html { scroll-behavior: smooth; }\n\n  body {\n    font-family: 'DM Sans', sans-serif;\n    background: var(--cream);\n    color: var(--charcoal);\n    font-weight: 300;\n    line-height: 1.7;\n    overflow-x: hidden;\n  }\n\n  \/* NAV *\/\n  nav {\n    position: fixed; top: 0; left: 0; right: 0; z-index: 100;\n    padding: 20px 48px;\n    display: flex; align-items: center; justify-content: space-between;\n    background: rgba(247,243,238,0.92);\n    backdrop-filter: blur(12px);\n    border-bottom: 0.5px solid var(--border);\n  }\n  .logo {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 20px; font-weight: 400; letter-spacing: 0.06em;\n    color: var(--charcoal);\n    text-decoration: none;\n  }\n  .logo span { color: var(--gold); }\n  .nav-cta {\n    font-size: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;\n    color: var(--charcoal); text-decoration: none;\n    padding: 10px 24px; border: 0.5px solid var(--charcoal);\n    transition: all 0.3s ease;\n  }\n  .nav-cta:hover { background: var(--charcoal); color: var(--cream); }\n  .gtranslate_wrapper { display: flex; align-items: center; gap: 6px; }\n  .gtranslate_wrapper img { display: block; border-radius: 2px; }\n  .nav-left { display: flex; align-items: center; gap: 40px; }\n  .nav-menu { display: flex; align-items: center; gap: 24px; }\n  .nav-menu a { font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--stone); text-decoration: none; transition: color 0.3s ease; }\n  .nav-menu a:hover { color: var(--gold); }\n  .nav-right { display: flex; align-items: center; gap: 24px; }\n\n  \/* HERO *\/\n  .hero {\n    min-height: 100vh;\n    padding: 120px 48px 80px;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 60px;\n    align-items: center;\n    position: relative;\n    overflow: hidden;\n  }\n  .hero::before {\n    content: '';\n    position: absolute; top: 0; right: 0;\n    width: 55%; height: 100%;\n    background: #EDE6DC;\n    z-index: 0;\n  }\n  .hero-left { position: relative; z-index: 1; }\n  .hero-eyebrow {\n    font-size: 11px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase;\n    color: var(--gold); margin-bottom: 24px;\n    display: flex; align-items: center; gap: 12px;\n  }\n  .hero-eyebrow::before {\n    content: ''; width: 32px; height: 0.5px; background: var(--gold);\n  }\n  .hero-headline {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: clamp(42px, 5vw, 64px);\n    font-weight: 300; line-height: 1.15;\n    color: var(--charcoal);\n    margin-bottom: 28px;\n  }\n  .hero-headline em { font-style: italic; color: var(--gold); }\n  .hero-sub {\n    font-size: 16px; font-weight: 300;\n    color: var(--stone);\n    max-width: 420px; margin-bottom: 40px;\n    line-height: 1.8;\n  }\n  .hero-actions { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }\n  .btn-primary {\n    display: inline-block;\n    background: var(--charcoal); color: var(--cream);\n    font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase;\n    padding: 16px 36px; text-decoration: none;\n    transition: all 0.3s ease;\n  }\n  .btn-primary:hover { background: var(--gold); }\n  .hero-note {\n    font-size: 12px; color: var(--stone); letter-spacing: 0.04em;\n  }\n  .hero-right {\n    position: relative; z-index: 1;\n    display: flex; align-items: center; justify-content: center;\n  }\n  .hero-img-frame {\n    width: 100%; max-width: 420px;\n    aspect-ratio: 3\/4;\n    background: var(--blush);\n    position: relative;\n    overflow: hidden;\n  }\n  .hero-img-frame::after {\n    content: 'MARI GOMES';\n    position: absolute; bottom: 24px; left: 24px;\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 13px; letter-spacing: 0.2em;\n    color: rgba(28,25,22,0.5);\n  }\n  .hero-badges {\n    position: absolute; bottom: -20px; left: -20px;\n    background: var(--warm-white); border: 0.5px solid var(--border);\n    padding: 20px 24px;\n  }\n  .hero-badges p { font-size: 11px; color: var(--stone); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 4px; }\n  .hero-badges strong { font-size: 22px; font-weight: 400; font-family: 'Cormorant Garamond', serif; }\n\n  \/* TRUST BAR *\/\n  .trust-bar {\n    background: var(--charcoal); color: var(--cream);\n    padding: 24px 48px;\n    display: flex; justify-content: space-around; align-items: center;\n    flex-wrap: wrap; gap: 24px;\n  }\n  .trust-item { text-align: center; }\n  .trust-item strong {\n    display: block;\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 28px; font-weight: 300;\n  }\n  .trust-item span { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.6; }\n\n  \/* SECTION BASE *\/\n  section { padding: 96px 48px; scroll-margin-top: 100px; }\n  .section-label {\n    font-size: 11px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase;\n    color: var(--gold); margin-bottom: 16px;\n    display: flex; align-items: center; gap: 12px;\n  }\n  .section-label::before { content: ''; width: 24px; height: 0.5px; background: var(--gold); }\n  .section-title {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: clamp(32px, 4vw, 48px);\n    font-weight: 300; line-height: 1.2;\n    margin-bottom: 20px;\n  }\n  .section-title em { font-style: italic; color: var(--gold); }\n\n  \/* ABOUT SECTION *\/\n  .about { background: var(--warm-white); }\n  .about-grid {\n    display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;\n    max-width: 1100px; margin: 0 auto;\n  }\n  .about-img {\n    aspect-ratio: 3\/4; background: #E8DDD4;\n    position: relative;\n  }\n  .about-img::before {\n    content: ''; position: absolute; top: -16px; left: -16px;\n    width: 100%; height: 100%;\n    border: 0.5px solid var(--gold);\n    z-index: -1;\n  }\n  .about-text p { font-size: 16px; color: var(--stone); margin-bottom: 20px; line-height: 1.8; }\n  .about-text p strong { color: var(--charcoal); font-weight: 400; }\n  .about-sig {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 28px; font-style: italic;\n    color: var(--charcoal); margin-top: 32px;\n  }\n\n  \/* THERAPIES *\/\n  .therapies { background: var(--cream); }\n  .therapies-grid {\n    display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px;\n    margin-top: 56px;\n  }\n  .therapy-card {\n    background: var(--warm-white); padding: 40px 32px;\n    border: 0.5px solid var(--border);\n    transition: all 0.3s ease;\n    position: relative; overflow: hidden;\n  }\n  .therapy-card::before {\n    content: ''; position: absolute; bottom: 0; left: 0;\n    width: 100%; height: 3px; background: var(--gold);\n    transform: scaleX(0); transform-origin: left;\n    transition: transform 0.4s ease;\n  }\n  .therapy-card:hover::before { transform: scaleX(1); }\n  .therapy-card:hover { background: #FBF8F4; }\n  .therapy-num {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 56px; font-weight: 300;\n    color: rgba(184,146,74,0.2);\n    line-height: 1; margin-bottom: 20px;\n  }\n  .therapy-name {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 22px; font-weight: 400;\n    margin-bottom: 12px;\n  }\n  .therapy-desc { font-size: 14px; color: var(--stone); line-height: 1.7; }\n\n  \/* EXPERIENCE SECTION *\/\n  .experience { background: var(--charcoal); color: var(--cream); }\n  .experience .section-label { color: var(--gold-light); }\n  .experience .section-label::before { background: var(--gold-light); }\n  .experience .section-title { color: var(--cream); }\n  .exp-grid {\n    display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px;\n    max-width: 900px; margin: 56px auto 0;\n  }\n  .exp-item {\n    padding: 32px; border: 0.5px solid rgba(255,255,255,0.12);\n    display: flex; gap: 20px; align-items: flex-start;\n  }\n  .exp-icon {\n    width: 40px; height: 40px; border-radius: 50%;\n    background: rgba(184,146,74,0.2);\n    display: flex; align-items: center; justify-content: center;\n    flex-shrink: 0; font-size: 18px;\n  }\n  .exp-item h4 {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 18px; font-weight: 400; margin-bottom: 8px;\n  }\n  .exp-item p { font-size: 13px; color: rgba(253,250,247,0.6); line-height: 1.7; }\n\n  \/* TESTIMONIALS *\/\n  .testimonials { background: var(--cream); }\n  .testi-grid {\n    display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;\n    margin-top: 56px;\n  }\n  .testi-card {\n    background: var(--warm-white);\n    border: 0.5px solid var(--border);\n    padding: 32px;\n  }\n  .testi-stars { color: var(--gold); font-size: 14px; margin-bottom: 16px; letter-spacing: 3px; }\n  .testi-text {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 17px; font-style: italic;\n    line-height: 1.7; color: var(--charcoal);\n    margin-bottom: 20px;\n  }\n  .testi-name { font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--stone); }\n\n  \/* FAQ *\/\n  .faq { background: var(--warm-white); }\n  .faq-grid { max-width: 720px; margin: 56px auto 0; }\n  .faq-item { border-bottom: 0.5px solid var(--border); padding: 24px 0; }\n  .faq-q {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 20px; font-weight: 400;\n    color: var(--charcoal); cursor: pointer;\n    display: flex; justify-content: space-between; align-items: center;\n    gap: 16px;\n  }\n  .faq-q span { font-size: 20px; color: var(--gold); flex-shrink: 0; transition: transform 0.3s; }\n  .faq-a { font-size: 15px; color: var(--stone); line-height: 1.8; padding-top: 16px; display: none; }\n  .faq-item.open .faq-a { display: block; }\n  .faq-item.open .faq-q span { transform: rotate(45deg); }\n\n  \/* CTA SECTION *\/\n  .cta-section {\n    background: #EDE6DC; text-align: center;\n    padding: 96px 48px;\n  }\n  .cta-section .section-title { margin-bottom: 16px; }\n  .cta-section p { font-size: 16px; color: var(--stone); max-width: 480px; margin: 0 auto 40px; line-height: 1.8; }\n  .btn-outline {\n    display: inline-block; color: var(--charcoal);\n    font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase;\n    padding: 16px 36px; border: 0.5px solid var(--charcoal);\n    text-decoration: none; margin-left: 16px;\n    transition: all 0.3s ease;\n  }\n  .btn-outline:hover { background: var(--charcoal); color: var(--cream); }\n  .cta-disclaimer { font-size: 12px; color: var(--stone); margin-top: 20px; opacity: 0.7; }\n\n  \/* LOCATION *\/\n  .location { background: var(--cream); }\n  .location-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; max-width: 1100px; margin: 0 auto; }\n  .location-address { font-size: 16px; color: var(--stone); line-height: 1.8; margin-bottom: 28px; }\n  .location-map { aspect-ratio: 4\/3; overflow: hidden; border: 0.5px solid var(--border); }\n  .location-map iframe { width: 100%; height: 100%; display: block; }\n\n  \/* FOOTER *\/\n  footer {\n    background: var(--charcoal); color: rgba(253,250,247,0.6);\n    padding: 40px 48px;\n    display: flex; justify-content: space-between; align-items: center;\n    flex-wrap: wrap; gap: 16px;\n  }\n  footer a { color: inherit; text-decoration: none; font-size: 13px; }\n  footer .logo { color: var(--cream); }\n\n  \/* RESPONSIVE *\/\n  @media (max-width: 768px) {\n    nav { padding: 16px 24px; }\n    .nav-menu { display: none; }\n    .hero { grid-template-columns: 1fr; padding: 100px 24px 60px; }\n    .hero::before { width: 100%; top: 55%; height: 50%; }\n    .hero-right { display: none; }\n    section { padding: 64px 24px; }\n    .about-grid, .therapies-grid, .testi-grid, .location-grid { grid-template-columns: 1fr; }\n    .exp-grid { grid-template-columns: 1fr; }\n    .trust-bar { padding: 20px 24px; }\n    footer { padding: 32px 24px; flex-direction: column; text-align: center; }\n  }\n\n  \/* ANIMATIONS *\/\n  @keyframes fadeUp {\n    from { opacity: 0; transform: translateY(24px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n  .hero-left > * {\n    opacity: 0;\n    animation: fadeUp 0.8s ease forwards;\n  }\n  .hero-eyebrow { animation-delay: 0.1s; }\n  .hero-headline { animation-delay: 0.25s; }\n  .hero-sub { animation-delay: 0.4s; }\n  .hero-actions { animation-delay: 0.55s; }\n<\/style>\n<\/head>\n<body>\n\n<nav>\n  <div class=\"nav-left\">\n    <a href=\"https:\/\/amarigomes.com\" class=\"logo\">Mari <span>Gomes<\/span><\/a>\n    <div class=\"nav-menu\">\n      <a href=\"#about\">About<\/a>\n      <a href=\"#therapies\">Therapies<\/a>\n      <a href=\"#testimonials\">Reviews<\/a>\n      <a href=\"#faq\">FAQ<\/a>\n      <a href=\"#location\">Location<\/a>\n    <\/div>\n  <\/div>\n  <div class=\"nav-right\">\n    <div class=\"gtranslate_wrapper\" id=\"gt-wrapper-41028573\"><\/div>\n    <script>\n      window.gtranslateSettings = window.gtranslateSettings || {};\n      window.gtranslateSettings['41028573'] = {\"default_language\":\"en\",\"languages\":[\"nl\",\"en\",\"fr\",\"pt\",\"es\"],\"url_structure\":\"none\",\"flag_style\":\"2d\",\"flag_size\":24,\"wrapper_selector\":\"#gt-wrapper-41028573\",\"alt_flags\":[],\"horizontal_position\":\"inline\",\"flags_location\":\"https:\/\/amarigomes.com\/wp-content\/plugins\/gtranslate\/flags\/\"}\n    <\/script>\n    <script src=\"https:\/\/amarigomes.com\/wp-content\/plugins\/gtranslate\/js\/flags.js?ver=7.0\" data-gt-widget-id=\"41028573\"><\/script>\n    <a href=\"https:\/\/wa.me\/31634366008?text=Hi%20Mari!%20I%27m%20interested%20in%20a%20Holistic%20Energy%20Massage%20session.%20Could%20you%20provide%20more%20details?\" class=\"nav-cta\" target=\"_blank\">Book a session<\/a>\n  <\/div>\n<\/nav>\n\n<!-- HERO -->\n<section class=\"hero\">\n  <div class=\"hero-left\">\n    <p class=\"hero-eyebrow\">Holistic Massage \u00b7 Amsterdam<\/p>\n    <h1 class=\"hero-headline\">\n      Restore your <em>energy,<\/em><br>\n      balance your chakras,<br>\n      find inner peace\n    <\/h1>\n    <p class=\"hero-sub\">\n      Feeling drained, disconnected, or out of balance? Our holistic energy sessions realign your body, mind, and vital energy \u2014 in a private, professional studio in Amsterdam.\n    <\/p>\n    <div class=\"hero-actions\">\n      <a href=\"https:\/\/wa.me\/31634366008?text=Hi%20Mari!%20I%27m%20interested%20in%20a%20Holistic%20Energy%20Massage%20session.%20Could%20you%20please%20send%20me%20more%20details%20and%20availability?\" class=\"btn-primary\" target=\"_blank\">Request your session \u2192<\/a>\n      <p class=\"hero-note\">Sessions by appointment \u00b7 Studio in Amsterdam \u00b7 Quote via WhatsApp<\/p>\n    <\/div>\n  <\/div>\n  <div class=\"hero-right\">\n    <div class=\"hero-img-frame\" style=\"background:transparent;overflow:hidden;\">\n<img src=\"https:\/\/amarigomes.com\/wp-content\/uploads\/2026\/06\/LP1_hero.webp\" alt=\"Mari Gomes, holistic massage therapist, in her Amsterdam studio\" style=\"width:100%;height:100%;object-fit:cover;display:block;\">\n      <div class=\"hero-badges\">\n        <p>Holistic specialist<\/p>\n        <strong>Mari Gomes<\/strong>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- TRUST BAR -->\n<div class=\"trust-bar\">\n  <div class=\"trust-item\"><strong>5\u2605<\/strong><span>Verified reviews<\/span><\/div>\n  <div class=\"trust-item\"><strong>Studio<\/strong><span>Amsterdam<\/span><\/div>\n  <div class=\"trust-item\"><strong>3<\/strong><span>Therapy modalities<\/span><\/div>\n  <div class=\"trust-item\"><strong>100%<\/strong><span>Personal approach<\/span><\/div>\n<\/div>\n\n<!-- ABOUT PROMISE -->\n<section class=\"about\" id=\"about\">\n  <div class=\"about-grid\">\n    <div class=\"about-img\" style=\"background:transparent;overflow:hidden;min-height:400px;\"><img src=\"https:\/\/amarigomes.com\/wp-content\/uploads\/2026\/06\/LP1_About.webp\" alt=\"Interior of Mari Gomes' private massage studio in Amsterdam\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\/div>\n    <div class=\"about-text\">\n      <div class=\"section-label\">Why Mari Gomes<\/div>\n      <h2 class=\"section-title\">A session that <em>goes beyond<\/em> the physical<\/h2>\n      <p>Most massages relieve physical tension. <strong>Holistic energy work goes deeper<\/strong> \u2014 it addresses the energetic root of that tension: blocked chakras, accumulated stress, emotional residues stored in the body.<\/p>\n      <p>Mari Gomes is a specialist in holistic energy therapies. Each session is tailored to what you bring that day \u2014 no scripts, no one-size-fits-all. Just precise, intentional work on your body's energy field.<\/p>\n      <p>Sessions take place in a <strong>private, carefully designed studio in Amsterdam<\/strong> \u2014 a space built for deep relaxation and confidential healing work.<\/p>\n      <div class=\"about-sig\">Mari Gomes<\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- THERAPIES -->\n<section class=\"therapies\" id=\"therapies\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div class=\"section-label\">What we offer<\/div>\n    <h2 class=\"section-title\">Three paths to <em>energetic balance<\/em><\/h2>\n    <div class=\"therapies-grid\">\n      <div class=\"therapy-card\">\n        <div class=\"therapy-num\">01<\/div>\n        <div class=\"therapy-name\">Energetic Healing Massage<\/div>\n        <p class=\"therapy-desc\">Combines therapeutic touch with energy healing techniques to restore your body's natural energy flow. Ideal for dissolving emotional blockages, reducing anxiety, and strengthening your spiritual connection. Goes well beyond conventional massage.<\/p>\n      <\/div>\n      <div class=\"therapy-card\">\n        <div class=\"therapy-num\">02<\/div>\n        <div class=\"therapy-name\">Holistic Healing Massage<\/div>\n        <p class=\"therapy-desc\">A full-body holistic approach that works simultaneously on physical tension and deeper energetic layers. Each session is an invitation to leave accumulated stress behind and access a state of genuine regeneration \u2014 body, mind, and energy.<\/p>\n      <\/div>\n      <div class=\"therapy-card\">\n        <div class=\"therapy-num\">03<\/div>\n        <div class=\"therapy-name\">Tantric Therapy<\/div>\n        <p class=\"therapy-desc\">Advanced energetic unblocking through conscious touch and breathing. Releases deeply stored trauma, reactivates vital energy, and creates emotional balance. A profound therapeutic experience for those ready to go to the root.<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- EXPERIENCE -->\n<section class=\"experience\">\n  <div style=\"max-width: 1100px; margin: 0 auto; text-align: center;\">\n    <div class=\"section-label\" style=\"justify-content: center;\">The experience<\/div>\n    <h2 class=\"section-title\" style=\"max-width: 600px; margin: 0 auto 16px;\">What happens in <em>your session<\/em><\/h2>\n    <p style=\"color: rgba(253,250,247,0.6); max-width: 520px; margin: 0 auto; font-size: 15px;\">Each element of the session is intentional. Nothing is accidental.<\/p>\n    <div class=\"exp-grid\">\n      <div class=\"exp-item\">\n        <div class=\"exp-icon\">\u2726<\/div>\n        <div>\n          <h4>Conscious energetic touch<\/h4>\n          <p>Intentional pressure that relaxes deep muscles and unblocks energy pathways. Chakra balancing through precise, calibrated touch.<\/p>\n        <\/div>\n      <\/div>\n      <div class=\"exp-item\">\n        <div class=\"exp-icon\">\u25c9<\/div>\n        <div>\n          <h4>Guided conscious breathing<\/h4>\n          <p>Breathing techniques that help channel vital energy, release daily accumulated blockages, and deepen the state of presence.<\/p>\n        <\/div>\n      <\/div>\n      <div class=\"exp-item\">\n        <div class=\"exp-icon\">\u25c7<\/div>\n        <div>\n          <h4>Aromatic oils ritual<\/h4>\n          <p>Therapeutic aromas that heighten sensory awareness, enhance body relaxation, and promote mental clarity throughout the session.<\/p>\n        <\/div>\n      <\/div>\n      <div class=\"exp-item\">\n        <div class=\"exp-icon\">\u25cb<\/div>\n        <div>\n          <h4>Curated private studio<\/h4>\n          <p>A dedicated space in Amsterdam designed for deep work \u2014 lighting, music, and environment calibrated for complete immersion.<\/p>\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- TESTIMONIALS -->\n<section class=\"testimonials\" id=\"testimonials\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div class=\"section-label\">What clients say<\/div>\n    <h2 class=\"section-title\">Real experiences,<br><em>real transformations<\/em><\/h2>\n    <div class=\"testi-grid\">\n      <div class=\"testi-card\">\n        <div class=\"testi-stars\">\u2605\u2605\u2605\u2605\u2605<\/div>\n        <p class=\"testi-text\">\"The dedication she puts into her work, her presence, and the focus she maintains throughout the entire session are extraordinary.\"<\/p>\n        <p class=\"testi-name\">Fern\u00e3o O.<\/p>\n      <\/div>\n      <div class=\"testi-card\">\n        <div class=\"testi-stars\">\u2605\u2605\u2605\u2605\u2605<\/div>\n        <p class=\"testi-text\">\"Everything from the decor to the lighting and music was thoughtfully curated. I left feeling relaxed and rejuvenated \u2014 like a new person.\"<\/p>\n        <p class=\"testi-name\">Kinuthia<\/p>\n      <\/div>\n      <div class=\"testi-card\">\n        <div class=\"testi-stars\">\u2605\u2605\u2605\u2605\u2605<\/div>\n        <p class=\"testi-text\">\"She makes you feel like you're floating with her incredible relaxation and energy balance techniques. The environment is professional and very welcoming.\"<\/p>\n        <p class=\"testi-name\">Larissa G.<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- FAQ -->\n<section class=\"faq\" id=\"faq\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div class=\"section-label\">Questions<\/div>\n    <h2 class=\"section-title\">Everything you need<br>to know <em>before booking<\/em><\/h2>\n    <div class=\"faq-grid\">\n      <div class=\"faq-item\">\n        <div class=\"faq-q\" onclick=\"toggleFaq(this)\">\n          What is the difference between holistic and conventional massage?\n          <span>+<\/span>\n        <\/div>\n        <div class=\"faq-a\">Conventional massage primarily addresses physical muscle tension. Holistic energy massage works simultaneously on physical, emotional, and energetic layers \u2014 addressing not just the symptom (tension) but its root cause (blockage in the energy field).<\/div>\n      <\/div>\n      <div class=\"faq-item\">\n        <div class=\"faq-q\" onclick=\"toggleFaq(this)\">\n          Does the session involve any sexual activity?\n          <span>+<\/span>\n        <\/div>\n        <div class=\"faq-a\">No. All sessions are strictly therapeutic and energetic. The work focuses on releasing blockages, restoring energy flow, and promoting genuine well-being. The environment is professional, safe, and respectful at all times.<\/div>\n      <\/div>\n      <div class=\"faq-item\">\n        <div class=\"faq-q\" onclick=\"toggleFaq(this)\">\n          How does pricing work? Can I get a quote?\n          <span>+<\/span>\n        <\/div>\n        <div class=\"faq-a\">Sessions are priced based on the modality and duration chosen. To receive a personalised quote with full details, simply send a message via WhatsApp \u2014 Mari will respond with all the information you need within a short time.<\/div>\n      <\/div>\n      <div class=\"faq-item\">\n        <div class=\"faq-q\" onclick=\"toggleFaq(this)\">\n          Where do sessions take place?\n          <span>+<\/span>\n        <\/div>\n        <div class=\"faq-a\">All sessions take place in Mari's private studio in Amsterdam. The address and exact directions are shared upon booking confirmation.<\/div>\n      <\/div>\n      <div class=\"faq-item\">\n        <div class=\"faq-q\" onclick=\"toggleFaq(this)\">\n          What should I wear to the session?\n          <span>+<\/span>\n        <\/div>\n        <div class=\"faq-a\">Wear comfortable, easy-to-remove clothing such as loose trousers and a simple top. Please arrive already showered if possible \u2014 a shower is available on-site as well.<\/div>\n      <\/div>\n      <div class=\"faq-item\">\n        <div class=\"faq-q\" onclick=\"toggleFaq(this)\">\n          Are there any contraindications?\n          <span>+<\/span>\n        <\/div>\n        <div class=\"faq-a\">Sessions are not recommended for those with fever, deep vein thrombosis, fractures, severe osteoporosis, open wounds, or high-risk pregnancy. If you have any health concerns, please mention them when booking.<\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- LOCATION -->\n<section class=\"location\" id=\"location\">\n  <div class=\"location-grid\">\n    <div>\n      <div class=\"section-label\">Visit Us<\/div>\n      <h2 class=\"section-title\">F