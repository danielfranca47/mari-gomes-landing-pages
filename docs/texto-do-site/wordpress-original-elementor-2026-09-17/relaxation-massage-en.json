{"content":[{"id":"48701fa3","settings":[],"elements":[{"id":"25b9d143","settings":{"editor":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Relaxation & Stress Relief Massage Amsterdam | Mari Gomes<\/title>\n<link rel=\"preconnect\" href=\"https:\/\/fonts.googleapis.com\">\n<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=Nunito+Sans:wght@300;400;600&display=swap\" rel=\"stylesheet\">\n<style>\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n  :root {\n    --sand: #F0EAE0;\n    --linen: #FAF7F3;\n    --deep: #2A2420;\n    --muted: #7A7068;\n    --moss: #5C6B55;\n    --moss-light: #8CA882;\n    --terracotta: #B5644A;\n    --terra-light: #D4917D;\n    --border: rgba(42,36,32,0.09);\n  }\n  html { scroll-behavior: smooth; }\n  body { font-family: 'Nunito Sans', sans-serif; background: var(--linen); color: var(--deep); font-weight: 300; line-height: 1.7; overflow-x: hidden; }\n\n  nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: 18px 48px; display: flex; align-items: center; justify-content: space-between; background: rgba(250,247,243,0.94); backdrop-filter: blur(12px); border-bottom: 0.5px solid var(--border); }\n  .logo { font-family: 'Playfair Display', serif; font-size: 19px; font-weight: 400; color: var(--deep); text-decoration: none; letter-spacing: 0.04em; }\n  .logo span { color: var(--moss); }\n  .nav-cta { font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--linen); background: var(--moss); text-decoration: none; padding: 10px 24px; transition: background 0.3s; }\n  .nav-cta:hover { background: var(--deep); }\n  .gtranslate_wrapper { display: flex; align-items: center; gap: 6px; }\n  .gtranslate_wrapper img { display: block; border-radius: 2px; }\n  .nav-left { display: flex; align-items: center; gap: 40px; }\n  .nav-menu { display: flex; align-items: center; gap: 22px; }\n  .nav-menu a { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); text-decoration: none; transition: color 0.3s ease; }\n  .nav-menu a:hover { color: var(--moss); }\n  .nav-right { display: flex; align-items: center; gap: 22px; }\n\n  \/* HERO \u2014 two-tone split with stress visual *\/\n  .hero {\n    min-height: 100vh; padding: 112px 0 0;\n    display: flex; flex-direction: column;\n  }\n  .hero-top {\n    flex: 1; display: grid; grid-template-columns: 1fr 1fr;\n    align-items: center;\n  }\n  .hero-left { padding: 64px 64px 64px 48px; }\n  .hero-tag {\n    display: inline-flex; align-items: center; gap: 8px;\n    background: rgba(92,107,85,0.1); border: 0.5px solid rgba(92,107,85,0.3);\n    padding: 6px 14px; font-size: 11px; font-weight: 600; letter-spacing: 0.12em;\n    text-transform: uppercase; color: var(--moss); margin-bottom: 28px;\n  }\n  .hero-headline { font-family: 'Playfair Display', serif; font-size: clamp(38px, 4.5vw, 58px); font-weight: 400; line-height: 1.2; color: var(--deep); margin-bottom: 24px; }\n  .hero-headline em { font-style: italic; color: var(--moss); }\n  .hero-sub { font-size: 16px; color: var(--muted); max-width: 400px; margin-bottom: 36px; line-height: 1.8; }\n  .hero-cta-group { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }\n  .btn-moss { display: inline-block; background: var(--moss); color: var(--linen); font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; padding: 15px 32px; text-decoration: none; transition: background 0.3s; }\n  .btn-moss:hover { background: var(--deep); }\n  .btn-outline { display: inline-block; background: transparent; color: var(--moss); font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; padding: 14px 30px; border: 1.5px solid var(--moss); text-decoration: none; transition: all 0.3s; }\n  .btn-outline:hover { background: var(--moss); color: var(--linen); }\n  .location { background: var(--linen); }\n  .location-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; max-width: 1100px; margin: 0 auto; }\n  .location-address { font-size: 16px; color: var(--muted); line-height: 1.8; margin-bottom: 28px; }\n  .location-map { aspect-ratio: 4\/3; overflow: hidden; border: 0.5px solid var(--border); }\n  .location-map iframe { width: 100%; height: 100%; display: block; }\n  .hero-cta-note { font-size: 12px; color: var(--muted); }\n  .hero-right { background: var(--sand); height: 100%; min-height: 460px; display: flex; align-items: center; justify-content: center; padding: 48px; }\n  .hero-visual {\n    width: 100%; max-width: 380px;\n    background: var(--linen);\n    padding: 32px;\n    border: 0.5px solid var(--border);\n  }\n  .hero-visual-title { font-family: 'Playfair Display', serif; font-size: 14px; color: var(--muted); margin-bottom: 24px; letter-spacing: 0.06em; }\n  .benefit-row { display: flex; align-items: center; gap: 14px; padding: 14px 0; border-bottom: 0.5px solid var(--border); }\n  .benefit-row:last-child { border-bottom: none; }\n  .benefit-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--moss); flex-shrink: 0; }\n  .benefit-text { font-size: 14px; color: var(--deep); }\n  .benefit-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }\n\n  \/* STRIP *\/\n  .strip { background: var(--moss); color: var(--linen); padding: 20px 48px; display: flex; justify-content: center; gap: 64px; flex-wrap: wrap; }\n  .strip-item { font-size: 13px; display: flex; align-items: center; gap: 8px; }\n  .strip-item::before { content: '\u2713'; font-weight: 600; }\n\n  \/* SECTIONS *\/\n  section { padding: 88px 48px; scroll-margin-top: 90px; }\n  .label { font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--moss); margin-bottom: 12px; }\n  .title { font-family: 'Playfair Display', serif; font-size: clamp(30px, 3.5vw, 44px); font-weight: 400; line-height: 1.25; margin-bottom: 20px; }\n  .title em { font-style: italic; color: var(--moss); }\n\n  \/* HOW IT WORKS *\/\n  .how { background: var(--linen); }\n  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-top: 56px; position: relative; }\n  .steps::before { content: ''; position: absolute; top: 24px; left: 12%; right: 12%; height: 0.5px; background: var(--border); z-index: 0; }\n  .step { position: relative; z-index: 1; text-align: center; }\n  .step-circle { width: 48px; height: 48px; border-radius: 50%; background: var(--linen); border: 1.5px solid var(--moss); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-family: 'Playfair Display', serif; font-size: 18px; color: var(--moss); }\n  .step-title { font-size: 14px; font-weight: 600; margin-bottom: 8px; }\n  .step-desc { font-size: 13px; color: var(--muted); line-height: 1.6; }\n\n  \/* SESSION TYPES *\/\n  .sessions { background: var(--sand); }\n  .session-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 48px; }\n  .session-card { background: var(--linen); padding: 36px; border: 0.5px solid var(--border); position: relative; overflow: hidden; }\n  .session-card::after { content: ''; position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: var(--moss); }\n  .session-card h3 { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 400; margin-bottom: 12px; }\n  .session-card p { font-size: 14px; color: var(--muted); line-height: 1.8; margin-bottom: 16px; }\n  .session-for { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--moss); }\n\n  \/* ABOUT *\/\n  .about { background: var(--deep); color: var(--linen); }\n  .about .label { color: var(--moss-light); }\n  .about .title { color: var(--linen); }\n  .about-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 72px; align-items: center; max-width: 1000px; margin: 0 auto; }\n  .about-portrait { aspect-ratio: 3\/4; background: rgba(255,255,255,0.06); border: 0.5px solid rgba(255,255,255,0.1); }\n  .about-content p { font-size: 15px; color: rgba(250,247,243,0.72); line-height: 1.85; margin-bottom: 18px; }\n  .about-content p strong { color: var(--linen); font-weight: 400; }\n  .about-sig { font-family: 'Playfair Display', serif; font-size: 26px; font-style: italic; color: var(--linen); margin-top: 28px; }\n\n  \/* TESTIMONIALS *\/\n  .testimonials { background: var(--linen); }\n  .testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 48px; }\n  .testi-card { background: var(--sand); padding: 28px; border: 0.5px solid var(--border); }\n  .testi-stars { color: var(--terracotta); letter-spacing: 3px; font-size: 13px; margin-bottom: 14px; }\n  .testi-quote { font-family: 'Playfair Display', serif; font-size: 16px; font-style: italic; line-height: 1.7; color: var(--deep); margin-bottom: 18px; }\n  .testi-by { font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }\n\n  \/* FAQ *\/\n  .faq { background: var(--sand); }\n  .faq-inner { max-width: 680px; margin: 48px auto 0; }\n  .faq-item { border-bottom: 0.5px solid var(--border); padding: 22px 0; }\n  .faq-q { font-family: 'Playfair Display', serif; font-size: 18px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; color: var(--deep); }\n  .faq-q span { color: var(--moss); font-size: 22px; flex-shrink: 0; transition: transform 0.3s; }\n  .faq-a { font-size: 14px; color: var(--muted); line-height: 1.8; padding-top: 14px; display: none; }\n  .faq-item.open .faq-a { display: block; }\n  .faq-item.open .faq-q span { transform: rotate(45deg); }\n\n  \/* CTA *\/\n  .cta-final { background: var(--moss); color: var(--linen); text-align: center; padding: 88px 48px; }\n  .cta-final .label { color: rgba(250,247,243,0.6); }\n  .cta-final .title { color: var(--linen); margin-bottom: 16px; }\n  .cta-final p { font-size: 15px; color: rgba(250,247,243,0.75); max-width: 460px; margin: 0 auto 36px; line-height: 1.8; }\n  .btn-white { display: inline-block; background: var(--linen); color: var(--moss); font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; padding: 15px 36px; text-decoration: none; transition: all 0.3s; }\n  .btn-white:hover { background: var(--deep); color: var(--linen); }\n  .cta-note { font-size: 12px; color: rgba(250,247,243,0.5); margin-top: 16px; }\n\n  footer { background: var(--deep); color: rgba(250,247,243,0.5); padding: 36px 48px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }\n  footer a { color: inherit; text-decoration: none; font-size: 13px; }\n  footer .logo { color: var(--linen); }\n\n  @media (max-width: 768px) {\n    nav { padding: 16px 24px; }\n    .nav-menu { display: none; }\n    .hero-top { grid-template-columns: 1fr; }\n    .hero-left { padding: 48px 24px; }\n    .hero-right { min-height: 300px; padding: 32px 24px; }\n    section { padding: 56px 24px; }\n    .steps { grid-template-columns: 1fr 1fr; }\n    .steps::before { display: none; }\n    .session-grid, .testi-grid, .location-grid { grid-template-columns: 1fr; }\n    .about-grid { grid-template-columns: 1fr; }\n    .about-portrait { display: none; }\n    .strip { gap: 24px; padding: 16px 24px; flex-direction: column; }\n    footer { flex-direction: column; text-align: center; padding: 28px 24px; }\n  }\n\n  @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }\n  .hero-tag { opacity: 0; animation: fadeUp 0.7s ease 0.1s forwards; }\n  .hero-headline { opacity: 0; animation: fadeUp 0.7s ease 0.25s forwards; }\n  .hero-sub { opacity: 0; animation: fadeUp 0.7s ease 0.4s forwards; }\n  .hero-cta-group { opacity: 0; animation: fadeUp 0.7s ease 0.55s forwards; }\n<\/style>\n<\/head>\n<body>\n\n<nav>\n  <div class=\"nav-left\">\n    <a href=\"https:\/\/amarigomes.com\" class=\"logo\">Mari <span>Gomes<\/span><\/a>\n    <div class=\"nav-menu\">\n      <a href=\"#sessions\">Sessions<\/a>\n      <a href=\"#about\">About<\/a>\n      <a href=\"#testimonials\">Reviews<\/a>\n      <a href=\"#faq\">FAQ<\/a>\n      <a href=\"#location\">Location<\/a>\n    <\/div>\n  <\/div>\n  <div class=\"nav-right\">\n    <div class=\"gtranslate_wrapper\" id=\"gt-wrapper-63841029\"><\/div>\n    <script>\n      window.gtranslateSettings = window.gtranslateSettings || {};\n      window.gtranslateSettings['63841029'] = {\"default_language\":\"en\",\"languages\":[\"nl\",\"en\",\"fr\",\"pt\",\"es\"],\"url_structure\":\"none\",\"flag_style\":\"2d\",\"flag_size\":24,\"wrapper_selector\":\"#gt-wrapper-63841029\",\"alt_flags\":[],\"horizontal_position\":\"inline\",\"flags_location\":\"https:\/\/amarigomes.com\/wp-content\/plugins\/gtranslate\/flags\/\"}\n    <\/script>\n    <script src=\"https:\/\/amarigomes.com\/wp-content\/plugins\/gtranslate\/js\/flags.js?ver=7.0\" data-gt-widget-id=\"63841029\"><\/script>\n    <a href=\"https:\/\/wa.me\/31634366008?text=Hi%20Mari!%20I%27m%20interested%20in%20a%20Relaxation%20Massage%20session.%20Could%20you%20send%20me%20more%20details?\" class=\"nav-cta\" target=\"_blank\">Book a session<\/a>\n  <\/div>\n<\/nav>\n\n<!-- HERO -->\n<div class=\"hero\">\n  <div class=\"hero-top\">\n    <div class=\"hero-left\">\n      <div class=\"hero-tag\">Relaxation Massage \u00b7 Amsterdam<\/div>\n      <h1 class=\"hero-headline\">\n        Deep relaxation.<br>\n        Stress released.<br>\n        <em>Body restored.<\/em>\n      <\/h1>\n      <p class=\"hero-sub\">Carrying stress in your shoulders, your chest, your jaw? A full-body session at our Amsterdam studio releases tension where it lives \u2014 physically and energetically.<\/p>\n      <div class=\"hero-cta-group\">\n        <a href=\"https:\/\/wa.me\/31634366008?text=Hi%20Mari!%20I%27m%20interested%20in%20a%20Relaxation%20and%20Stress%20Relief%20Massage.%20Could%20you%20please%20send%20me%20more%20details%20and%20a%20quote?\" class=\"btn-moss\" target=\"_blank\">Request your quote \u2192<\/a>\n        <p class=\"hero-cta-note\">Studio sessions in Amsterdam \u00b7 Quote via WhatsApp \u00b7 Sessions by appointment<\/p>\n      <\/div>\n    <\/div>\n    <div class=\"hero-right\" style=\"padding:0;\">\n      <div style=\"flex:1;min-height:220px;overflow:hidden;\"><img src=\"https:\/\/amarigomes.com\/wp-content\/uploads\/2026\/06\/LP2_Hero.webp\" alt=\"Client receiving a relaxation massage at Mari Gomes' studio in Amsterdam\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\/div>\n    <div class=\"hero-visual\" style=\"border-top:none;\">\n        <p class=\"hero-visual-title\">What this session does for you<\/p>\n        <div class=\"benefit-row\"><div class=\"benefit-dot\"><\/div><div><div class=\"benefit-text\">Releases physical tension<\/div><div class=\"benefit-sub\">neck, shoulders, lower back, jaw<\/div><\/div><\/div>\n        <div class=\"benefit-row\"><div class=\"benefit-dot\"><\/div><div><div class=\"benefit-text\">Reduces stress and anxiety<\/div><div class=\"benefit-sub\">calms the nervous system naturally<\/div><\/div><\/div>\n        <div class=\"benefit-row\"><div class=\"benefit-dot\"><\/div><div><div class=\"benefit-text\">Promotes deep sleep<\/div><div class=\"benefit-sub\">resets sleep patterns from session one<\/div><\/div><\/div>\n        <div class=\"benefit-row\"><div class=\"benefit-dot\"><\/div><div><div class=\"benefit-text\">Restores mental clarity<\/div><div class=\"benefit-sub\">leaves the fog, brings the focus<\/div><\/div><\/div>\n        <div class=\"benefit-row\"><div class=\"benefit-dot\"><\/div><div><div class=\"benefit-text\">Full-body holistic approach<\/div><div class=\"benefit-sub\">not just muscles \u2014 your whole system<\/div><\/div><\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/div>\n\n<!-- STRIP -->\n<div class=\"strip\">\n  <span class=\"strip-item\">Private studio in Amsterdam<\/span>\n  <span class=\"strip-item\">Personal & professional approach<\/span>\n  <span class=\"strip-item\">Sessions by appointment<\/span>\n  <span class=\"strip-item\">5-star reviewed<\/span>\n<\/div>\n\n<!-- HOW IT WORKS -->\n<section class=\"how\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div class=\"label\">How it works<\/div>\n    <h2 class=\"title\">From first contact to<br><em>deep restoration<\/em><\/h2>\n    <div class=\"steps\">\n      <div class=\"step\">\n        <div class=\"step-circle\">1<\/div>\n        <div class=\"step-title\">Send a message<\/div>\n        <p class=\"step-desc\">Contact Mari via WhatsApp. Describe what you're looking for and receive a personalised quote within a short time.<\/p>\n      <\/div>\n      <div class=\"step\">\n        <div class=\"step-circle\">2<\/div>\n        <div class=\"step-title\">Choose your session<\/div>\n        <p class=\"step-desc\">Together you choose the best session type and duration for your needs \u2014 from a focused 60-min to a full 2-hour session.<\/p>\n      <\/div>\n      <div class=\"step\">\n        <div class=\"step-circle\">3<\/div>\n        <div class=\"step-title\">Arrive at the studio<\/div>\n        <p class=\"step-desc\">You arrive at a curated private studio in Amsterdam, designed for complete relaxation from the moment you walk in.<\/p>\n      <\/div>\n      <div class=\"step\">\n        <div class=\"step-circle\">4<\/div>\n        <div class=\"step-title\">Leave restored<\/div>\n        <p class=\"step-desc\">You leave lighter, calmer, and clearer. Most clients feel the difference immediately \u2014 body and mind reset.<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- SESSION TYPES -->\n<section class=\"sessions\" id=\"sessions\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div class=\"label\">Session options<\/div>\n    <h2 class=\"title\">Choose the <em>right depth<\/em> for you<\/h2>\n    <div class=\"session-grid\">\n      <div class=\"session-card\">\n        <h3>Relaxation & Holistic Massage<\/h3>\n        <p>A full-body massage that combines deep physical relaxation with a holistic energy approach. Relieves accumulated tension from muscles while restoring overall well-being and calm. Ideal for those who want to switch off completely.<\/p>\n        <p class=\"session-for\">Best for \u2192 chronic stress \u00b7 muscle tension \u00b7 mental fatigue<\/p>\n      <\/div>\n      <div class=\"session-card\">\n        <h3>Energetic Healing Massage<\/h3>\n        <p>Goes beyond physical relief. This session targets the energetic root of your tension \u2014 dissolving emotional blockages, restoring energy flow, and leaving you with a deep sense of renewal that lasts well beyond the session itself.<\/p>\n        <p class=\"session-for\">Best for \u2192 burnout \u00b7 anxiety \u00b7 feeling disconnected<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- ABOUT -->\n<section class=\"about\" id=\"about\">\n  <div class=\"about-grid\">\n    <div class=\"about-portrait\" style=\"background:transparent;overflow:hidden;\"><img src=\"https:\/\/amarigomes.com\/wp-content\/uploads\/2026\/06\/LP1_About.webp\" alt=\"Interior of Mari Gomes' private massage studio in Amsterdam\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\/div>\n    <div class=\"about-content\">\n      <div class=\"label\">Your therapist<\/div>\n      <h2 class=\"title\">Technique, <em>sensitivity<\/em>, and depth<\/h2>\n      <p>Mari Gomes is a specialist therapist in energy massage and holistic body therapies. With extensive experience, she combines <strong>precise technique with genuine sensitivity<\/strong> \u2014 each session is calibrated to what you bring that day, not a fixed script.<\/p>\n      <p>Her method is recognised for its depth and precision. She works with the body as a whole \u2014 physical, emotional, and energetic \u2014 because real relaxation means releasing tension at every layer, not just the surface.<\/p>\n      <p><strong>All sessions take place in a private studio in Amsterdam.<\/strong> The space is designed to support deep work from the moment you arrive.<\/p>\n      <div class=\"about-sig\">Mari Gomes<\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- TESTIMONIALS -->\n<section class=\"testimonials\" id=\"testimonials\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div class=\"label\">Client experiences<\/div>\n    <h2 class=\"title\">They came stressed.<br><em>They left transformed.<\/em><\/h2>\n    <div class=\"testi-grid\">\n      <div class=\"testi-card\">\n        <div class=\"testi-stars\">\u2605\u2605\u2605\u2605\u2605<\/div>\n        <p class=\"testi-quote\">\"She is very attentive and truly helps you rest and recharge. I highly recommend her \u2014 an amazing experience from start to finish.\"<\/p>\n        <p class=\"testi-by\">Jonas<\/p>\n      <\/div>\n      <div class=\"testi-card\">\n        <div class=\"testi-stars\">\u2605\u2605\u2605\u2605\u2605<\/div>\n        <p class=\"testi-quote\">\"Everything from the decor to the lighting and music was thoughtfully curated. I left feeling relaxed and rejuvenated \u2014 like a new person.\"<\/p>\n        <p class=\"testi-by\">Kinuthia<\/p>\n      <\/div>\n      <div class=\"testi-card\">\n        <div class=\"testi-stars\">\u2605\u2605\u2605\u2605\u2605<\/div>\n        <p class=\"testi-quote\">\"Her presence and focus throughout the entire session are extraordinary. You feel completely taken care of from the first moment.\"<\/p>\n        <p class=\"testi-by\">Fern\u00e3o O.<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- FAQ -->\n<section class=\"faq\" id=\"faq\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div class=\"label\">Questions & answers<\/div>\n    <h2 class=\"title\">Everything you need to know<br><em>before you book<\/em><\/h2>\n    <div class=\"faq-inner\">\n      <div class=\"faq-item\">\n        <div class=\"faq-q\" onclick=\"toggleFaq(this)\">How do I get a price \/ quote?<span>+<\/span><\/div>\n        <div class=\"faq-a\">Sessions are priced based on the modality and duration chosen. Send a WhatsApp message and Mari will reply with a personalised quote, full details, and available time slots \u2014 usually within a short time.<\/div>\n      <\/div>\n      <div class=\"faq-item\">\n        <div class=\"faq-q\" onclick=\"toggleFaq(this)\">Where does the session take place?<span>+<\/span><\/div>\n        <div class=\"faq-a\">All sessions take place in Mari's private studio in Amsterdam. The exact address and directions are shared upon booking confirmation.<\/div>\n      <\/div>\n      <div class=\"faq-item\">\n        <div class=\"faq-q\" onclick=\"toggleFaq(this)\">Is this a sexual service?<span>+<\/span><\/div>\n        <div class=\"faq-a\">No. All sessions are strictly therapeutic. The focus is on physical relief, energetic restoration, and genuine well-being. The studio is professional and fully respectful at all times.<\/div>\n      <\/div>\n      <div class=\"faq-item\">\n        <div class=\"faq-q\" onclick=\"toggleFaq(this)\">What should I wear \/ bring?<span>+<\/span><\/div>\n        <div class=\"faq-a\">Wear comfortable, easy-to-remove clothing. Please come showered if possible \u2014 a shower is available on-site. Payment by cash or card.<\/div>\n      <\/div>\n      <div class=\"faq-item\">\n        <div class=\"faq-q\" onclick=\"toggleFaq(this)\">How long is a session?<span>+<\/span><\/div>\n        <div class=\"faq-a\">Sessions are available in 60, 90, and 120-minute formats. Mari will recommend the best duration based on your goals when you get in touch.<\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- LOCATION -->\n<section class=\"location\" id=\"location\">\n  <div class=\"location-grid\">\n