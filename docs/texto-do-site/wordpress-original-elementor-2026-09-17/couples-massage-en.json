{"content":[{"id":"683293b6","settings":[],"elements":[{"id":"6a9f9621","settings":{"editor":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Couples Massage Amsterdam | Holistic Experience for Two | Mari Gomes<\/title>\n<link rel=\"preconnect\" href=\"https:\/\/fonts.googleapis.com\">\n<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Jost:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n  :root {\n    --ivory: #F8F4EF;\n    --white: #FEFCFA;\n    --ink: #1E1A17;\n    --warm-gray: #7C746E;\n    --rose: #9B5E52;\n    --rose-light: #C4897E;\n    --blush: #EDD9D3;\n    --gold: #A87B4A;\n    --border: rgba(30,26,23,0.09);\n  }\n  html { scroll-behavior: smooth; }\n  body { font-family: 'Jost', sans-serif; background: var(--ivory); color: var(--ink); font-weight: 300; line-height: 1.7; overflow-x: hidden; }\n\n  nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: 20px 48px; display: flex; align-items: center; justify-content: space-between; background: rgba(248,244,239,0.93); backdrop-filter: blur(12px); border-bottom: 0.5px solid var(--border); }\n  .logo { font-family: 'Libre Baskerville', serif; font-size: 18px; font-weight: 400; color: var(--ink); text-decoration: none; letter-spacing: 0.04em; }\n  .logo span { color: var(--rose); }\n  .nav-cta { font-size: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--white); background: var(--rose); text-decoration: none; padding: 10px 24px; transition: background 0.3s; }\n  .nav-cta:hover { background: var(--ink); }\n  .gtranslate_wrapper { display: flex; align-items: center; gap: 6px; }\n  .gtranslate_wrapper img { display: block; border-radius: 2px; }\n  .nav-left { display: flex; align-items: center; gap: 40px; }\n  .nav-menu { display: flex; align-items: center; gap: 22px; }\n  .nav-menu a { font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--warm-gray); text-decoration: none; transition: color 0.3s ease; }\n  .nav-menu a:hover { color: var(--rose); }\n  .nav-right { display: flex; align-items: center; gap: 22px; }\n\n  \/* HERO \u2014 romantic, warm *\/\n  .hero {\n    min-height: 100vh;\n    display: grid; grid-template-columns: 1fr 1fr;\n    padding-top: 80px;\n    background: var(--ivory);\n  }\n  .hero-left {\n    background: var(--blush);\n    display: flex; align-items: flex-end;\n    padding: 64px 48px;\n    min-height: 560px;\n    position: relative;\n    overflow: hidden;\n  }\n  .hero-left::before {\n    content: '\u2767';\n    position: absolute; top: 40px; left: 48px;\n    font-size: 48px; color: rgba(155,94,82,0.2);\n  }\n  .hero-number {\n    font-family: 'Libre Baskerville', serif;\n    font-size: 180px; font-weight: 400;\n    color: rgba(155,94,82,0.1);\n    position: absolute; top: 20px; right: -10px;\n    line-height: 1; user-select: none;\n  }\n  .hero-left-content { position: relative; z-index: 1; }\n  .hero-tag { font-size: 11px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--rose); margin-bottom: 16px; display: flex; align-items: center; gap: 10px; }\n  .hero-tag::before { content: ''; width: 20px; height: 0.5px; background: var(--rose); }\n  .hero-pull {\n    font-family: 'Libre Baskerville', serif;\n    font-size: clamp(28px, 3.5vw, 44px);\n    font-weight: 400; font-style: italic;\n    line-height: 1.3; color: var(--ink);\n  }\n\n  .hero-right {\n    display: flex; flex-direction: column; justify-content: center;\n    padding: 80px 64px 64px 56px;\n  }\n  .hero-eyebrow { font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--rose); margin-bottom: 20px; }\n  .hero-headline {\n    font-family: 'Libre Baskerville', serif;\n    font-size: clamp(34px, 3.8vw, 52px);\n    font-weight: 400; line-height: 1.2;\n    color: var(--ink); margin-bottom: 24px;\n  }\n  .hero-headline em { font-style: italic; color: var(--rose); }\n  .hero-sub { font-size: 16px; color: var(--warm-gray); max-width: 400px; margin-bottom: 36px; line-height: 1.8; }\n  .btn-rose { display: inline-block; background: var(--rose); color: var(--white); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; padding: 16px 36px; text-decoration: none; transition: background 0.3s; }\n  .btn-rose:hover { background: var(--ink); }\n  .btn-outline { display: inline-block; background: transparent; color: var(--rose); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; padding: 15px 34px; border: 1px solid var(--rose); text-decoration: none; transition: all 0.3s; }\n  .btn-outline:hover { background: var(--rose); color: var(--white); }\n  .location { background: var(--blush); }\n  .location-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; max-width: 1100px; margin: 0 auto; }\n  .location-address { font-size: 16px; color: var(--warm-gray); line-height: 1.8; margin-bottom: 28px; }\n  .location-map { aspect-ratio: 4\/3; overflow: hidden; border: 0.5px solid var(--border); }\n  .location-map iframe { width: 100%; height: 100%; display: block; }\n  .hero-note { font-size: 12px; color: var(--warm-gray); margin-top: 12px; }\n\n  \/* PROMISE BAR *\/\n  .promise-bar {\n    background: var(--ink); color: var(--ivory);\n    padding: 28px 48px;\n    display: grid; grid-template-columns: repeat(3, 1fr);\n    gap: 1px;\n  }\n  .promise-item { padding: 0 32px; text-align: center; border-right: 0.5px solid rgba(255,255,255,0.1); }\n  .promise-item:last-child { border-right: none; }\n  .promise-icon { font-size: 22px; margin-bottom: 8px; }\n  .promise-title { font-family: 'Libre Baskerville', serif; font-size: 16px; font-weight: 400; margin-bottom: 4px; }\n  .promise-desc { font-size: 12px; color: rgba(248,244,239,0.55); line-height: 1.5; }\n\n  \/* SECTIONS *\/\n  section { padding: 96px 48px; scroll-margin-top: 100px; }\n  .label { font-size: 11px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--rose); margin-bottom: 14px; display: flex; align-items: center; gap: 10px; }\n  .label::before { content: ''; width: 20px; height: 0.5px; background: var(--rose); }\n  .title { font-family: 'Libre Baskerville', serif; font-size: clamp(28px, 3.5vw, 44px); font-weight: 400; line-height: 1.25; margin-bottom: 20px; }\n  .title em { font-style: italic; color: var(--rose); }\n\n  \/* FOR WHOM *\/\n  .for-whom { background: var(--white); }\n  .for-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 56px; }\n  .for-card { padding: 36px 28px; border: 0.5px solid var(--border); background: var(--ivory); }\n  .for-card-icon { font-size: 28px; margin-bottom: 20px; }\n  .for-card h3 { font-family: 'Libre Baskerville', serif; font-size: 19px; font-weight: 400; margin-bottom: 12px; color: var(--ink); }\n  .for-card p { font-size: 14px; color: var(--warm-gray); line-height: 1.7; }\n\n  \/* EXPERIENCE *\/\n  .experience-section { background: var(--blush); }\n  .exp-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; max-width: 1100px; margin: 0 auto; }\n  .exp-visual { background: var(--ivory); aspect-ratio: 1; display: flex; align-items: center; justify-content: center; position: relative; border: 0.5px solid var(--border); }\n  .exp-visual-inner { text-align: center; padding: 40px; }\n  .exp-visual-inner .big { font-family: 'Libre Baskerville', serif; font-size: 80px; font-weight: 400; font-style: italic; color: var(--rose); line-height: 1; }\n  .exp-visual-inner p { font-size: 13px; color: var(--warm-gray); margin-top: 12px; letter-spacing: 0.08em; text-transform: uppercase; }\n  .exp-list { list-style: none; margin-top: 0; }\n  .exp-list li { padding: 18px 0; border-bottom: 0.5px solid rgba(30,26,23,0.1); display: flex; gap: 16px; align-items: flex-start; }\n  .exp-list li:last-child { border-bottom: none; }\n  .exp-list-num { font-family: 'Libre Baskerville', serif; font-size: 13px; font-style: italic; color: var(--rose); flex-shrink: 0; width: 24px; }\n  .exp-list-title { font-size: 15px; font-weight: 400; margin-bottom: 4px; }\n  .exp-list-desc { font-size: 13px; color: var(--warm-gray); line-height: 1.6; }\n\n  \/* SESSION OPTIONS *\/\n  .options { background: var(--white); }\n  .options-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; margin-top: 56px; }\n  .option-card { background: var(--ivory); padding: 36px 28px; border: 0.5px solid var(--border); position: relative; }\n  .option-popular { position: absolute; top: 0; left: 0; right: 0; background: var(--rose); color: var(--white); font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; text-align: center; padding: 6px; }\n  .option-card.featured { margin-top: -1px; border-color: var(--rose); }\n  .option-name { font-family: 'Libre Baskerville', serif; font-size: 20px; font-weight: 400; margin: 12px 0; }\n  .option-desc { font-size: 13px; color: var(--warm-gray); line-height: 1.7; margin-bottom: 16px; }\n  .option-cta { font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--rose); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }\n  .option-cta:hover { color: var(--ink); }\n\n  \/* TESTIMONIALS *\/\n  .testimonials { background: var(--ivory); }\n  .testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 56px; }\n  .testi-card { background: var(--white); border: 0.5px solid var(--border); padding: 32px; position: relative; }\n  .testi-card::before { content: '\"'; font-family: 'Libre Baskerville', serif; font-size: 64px; font-style: italic; color: var(--blush); position: absolute; top: 16px; left: 24px; line-height: 1; }\n  .testi-text { font-family: 'Libre Baskerville', serif; font-size: 15px; font-style: italic; line-height: 1.75; color: var(--ink); margin-bottom: 20px; padding-top: 36px; }\n  .testi-name { font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--warm-gray); }\n  .testi-stars { color: var(--gold); font-size: 12px; letter-spacing: 3px; margin-bottom: 4px; }\n\n  \/* FAQ *\/\n  .faq { background: var(--white); }\n  .faq-inner { max-width: 680px; margin: 56px auto 0; }\n  .faq-item { border-bottom: 0.5px solid var(--border); padding: 22px 0; }\n  .faq-q { font-family: 'Libre Baskerville', serif; font-size: 18px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; color: var(--ink); }\n  .faq-q span { color: var(--rose); font-size: 22px; flex-shrink: 0; transition: transform 0.3s; }\n  .faq-a { font-size: 14px; color: var(--warm-gray); line-height: 1.8; padding-top: 14px; display: none; }\n  .faq-item.open .faq-a { display: block; }\n  .faq-item.open .faq-q span { transform: rotate(45deg); }\n\n  \/* CTA FINAL *\/\n  .cta-final {\n    background: var(--rose); color: var(--white);\n    text-align: center; padding: 96px 48px;\n    position: relative; overflow: hidden;\n  }\n  .cta-final::before {\n    content: '\u2767';\n    position: absolute; font-size: 300px;\n    color: rgba(255,255,255,0.04);\n    top: -60px; right: -40px;\n    font-family: serif; user-select: none;\n  }\n  .cta-final .label { justify-content: center; color: rgba(248,244,239,0.65); }\n  .cta-final .label::before { background: rgba(248,244,239,0.4); }\n  .cta-final .title { color: var(--white); margin-bottom: 16px; }\n  .cta-final p { font-size: 16px; color: rgba(248,244,239,0.78); max-width: 460px; margin: 0 auto 40px; line-height: 1.8; }\n  .btn-ivory { display: inline-block; background: var(--ivory); color: var(--rose); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; padding: 16px 40px; text-decoration: none; transition: all 0.3s; }\n  .btn-ivory:hover { background: var(--ink); color: var(--ivory); }\n  .cta-note { font-size: 12px; color: rgba(248,244,239,0.5); margin-top: 16px; }\n\n  footer { background: var(--ink); color: rgba(248,244,239,0.5); padding: 36px 48px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }\n  footer a { color: inherit; text-decoration: none; font-size: 13px; }\n  footer .logo { color: var(--ivory); }\n\n  @media (max-width: 768px) {\n    nav { padding: 16px 24px; }\n    .nav-menu { display: none; }\n    .hero { grid-template-columns: 1fr; }\n    .hero-left { min-height: 240px; padding: 40px 24px; }\n    .hero-number { display: none; }\n    .hero-right { padding: 48px 24px; }\n    section { padding: 64px 24px; }\n    .promise-bar { grid-template-columns: 1fr; gap: 20px; padding: 32px 24px; }\n    .promise-item { border-right: none; border-bottom: 0.5px solid rgba(255,255,255,0.1); padding-bottom: 20px; }\n    .for-grid, .options-grid, .testi-grid, .location-grid { grid-template-columns: 1fr; }\n    .exp-layout { grid-template-columns: 1fr; }\n    .exp-visual { display: none; }\n    footer { flex-direction: column; text-align: center; padding: 28px 24px; }\n  }\n\n  @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }\n  .hero-eyebrow { opacity: 0; animation: fadeUp 0.7s ease 0.1s forwards; }\n  .hero-headline { opacity: 0; animation: fadeUp 0.7s ease 0.25s forwards; }\n  .hero-sub { opacity: 0; animation: fadeUp 0.7s ease 0.4s forwards; }\n  .btn-rose, .hero-note { opacity: 0; animation: fadeUp 0.7s ease 0.55s forwards; }\n<\/style>\n<\/head>\n<body>\n\n<nav>\n  <div class=\"nav-left\">\n    <a href=\"https:\/\/amarigomes.com\" class=\"logo\">Mari <span>Gomes<\/span><\/a>\n    <div class=\"nav-menu\">\n      <a href=\"#experience-section\">Experience<\/a>\n      <a href=\"#options\">Packages<\/a>\n      <a href=\"#testimonials\">Reviews<\/a>\n      <a href=\"#faq\">FAQ<\/a>\n      <a href=\"#location\">Location<\/a>\n    <\/div>\n  <\/div>\n  <div class=\"nav-right\">\n    <div class=\"gtranslate_wrapper\" id=\"gt-wrapper-85027364\"><\/div>\n    <script>\n      window.gtranslateSettings = window.gtranslateSettings || {};\n      window.gtranslateSettings['85027364'] = {\"default_language\":\"en\",\"languages\":[\"nl\",\"en\",\"fr\",\"pt\",\"es\"],\"url_structure\":\"none\",\"flag_style\":\"2d\",\"flag_size\":24,\"wrapper_selector\":\"#gt-wrapper-85027364\",\"alt_flags\":[],\"horizontal_position\":\"inline\",\"flags_location\":\"https:\/\/amarigomes.com\/wp-content\/plugins\/gtranslate\/flags\/\"}\n    <\/script>\n    <script src=\"https:\/\/amarigomes.com\/wp-content\/plugins\/gtranslate\/js\/flags.js?ver=7.0\" data-gt-widget-id=\"85027364\"><\/script>\n    <a href=\"https:\/\/wa.me\/31634366008?text=Hi%20Mari!%20My%20partner%20and%20I%20are%20interested%20in%20a%20couples%20massage%20session.%20Could%20you%20please%20send%20us%20more%20details%20and%20a%20quote?\" class=\"nav-cta\" target=\"_blank\">Book for two<\/a>\n  <\/div>\n<\/nav>\n\n<!-- HERO -->\n<div class=\"hero\">\n  <div class=\"hero-left\" style=\"background:transparent;position:relative;overflow:hidden;\">\n    <div style=\"position:absolute;inset:0;z-index:0;\"><img src=\"https:\/\/amarigomes.com\/wp-content\/uploads\/2026\/06\/LP3_Hero.webp\" alt=\"Couple relaxing together after a massage session at Mari Gomes' studio\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\/div>\n  <div class=\"hero-number\" style=\"z-index:1;position:relative;\">2<\/div>\n    <div class=\"hero-left-content\" style=\"position:relative;z-index:2;background:rgba(237,217,211,0.55);padding:20px;border-radius:4px;\">\n      <p class=\"hero-tag\">Couples massage<\/p>\n      <p class=\"hero-pull\">\"An experience<br>you share \u2014<br>and both feel.\"<\/p>\n    <\/div>\n  <\/div>\n  <div class=\"hero-right\">\n    <p class=\"hero-eyebrow\">Amsterdam \u00b7 Private Studio \u00b7 For two<\/p>\n    <h1 class=\"hero-headline\">\n      A holistic massage<br>\n      experience designed<br>\n      <em>for couples<\/em>\n    <\/h1>\n    <p class=\"hero-sub\">More than a massage \u2014 a shared journey that relieves stress, restores energy, and deepens connection. In a private, curated studio in Amsterdam.<\/p>\n    <a href=\"https:\/\/wa.me\/31634366008?text=Hi%20Mari!%20My%20partner%20and%20I%20are%20interested%20in%20a%20couples%20massage.%20Could%20you%20please%20send%20us%20details%20and%20a%20quote?\" class=\"btn-rose\" target=\"_blank\">Request your quote for two \u2192<\/a>\n    <p class=\"hero-note\">Private studio \u00b7 Sessions by appointment \u00b7 Quote via WhatsApp<\/p>\n  <\/div>\n<\/div>\n\n<!-- PROMISE BAR -->\n<div class=\"promise-bar\">\n  <div class=\"promise-item\">\n    <div class=\"promise-icon\">\u25c8<\/div>\n    <div class=\"promise-title\">Side by side<\/div>\n    <p class=\"promise-desc\">Experience the session together, in the same space, at the same time.<\/p>\n  <\/div>\n  <div class=\"promise-item\">\n    <div class=\"promise-icon\">\u25ce<\/div>\n    <div class=\"promise-title\">Tailored for two<\/div>\n    <p class=\"promise-desc\">Each session is personalised to what both of you bring that day.<\/p>\n  <\/div>\n  <div class=\"promise-item\">\n    <div class=\"promise-icon\">\u25c7<\/div>\n    <div class=\"promise-title\">Private studio<\/div>\n    <p class=\"promise-desc\">A dedicated, intimate space in Amsterdam designed for couples.<\/p>\n  <\/div>\n<\/div>\n\n<!-- FOR WHOM -->\n<section class=\"for-whom\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div class=\"label\">This session is for you if...<\/div>\n    <h2 class=\"title\">Made for every <em>kind of couple<\/em><\/h2>\n    <div class=\"for-grid\">\n      <div class=\"for-card\">\n        <div class=\"for-card-icon\">\u25c8<\/div>\n        <h3>You want to reconnect<\/h3>\n        <p>Busy lives create distance. A shared session slows everything down and creates space for genuine presence \u2014 together, without distraction.<\/p>\n      <\/div>\n      <div class=\"for-card\">\n        <div class=\"for-card-icon\">\u25ce<\/div>\n        <h3>You want something different<\/h3>\n        <p>A unique experience that goes beyond a dinner out. Something you'll both remember and talk about. A gift that gives at a deeper level.<\/p>\n      <\/div>\n      <div class=\"for-card\">\n        <div class=\"for-card-icon\">\u25c7<\/div>\n        <h3>You both carry stress<\/h3>\n        <p>When both partners are stressed, relationship quality suffers. Releasing tension together \u2014 in the same room, at the same time \u2014 creates a shared reset.<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- EXPERIENCE -->\n<section class=\"experience-section\" id=\"experience-section\">\n  <div class=\"exp-layout\">\n    <div class=\"exp-visual\" style=\"background:transparent;overflow:hidden;\"><img src=\"https:\/\/amarigomes.com\/wp-content\/uploads\/2026\/06\/LP3_Experience.webp\" alt=\"Treatment room ambiance set up for a couples massage session at Mari Gomes' studio\" style=\"width:100%;height:100%;object-fit:cover;display:block;\">\n      <div class=\"exp-visual-inner\" style=\"display:none;\">\n        <div class=\"big\">for<br>two<\/div>\n        <p>Amsterdam \u00b7 Studio \u00b7 Private<\/p>\n      <\/div>\n    <\/div>\n    <div>\n      <div class=\"label\">What happens in your session<\/div>\n      <h2 class=\"title\">Every detail <em>intentional<\/em><\/h2>\n      <ul class=\"exp-list\">\n        <li>\n          <div class=\"exp-list-num\">i.<\/div>\n          <div><div class=\"exp-list-title\">Welcoming ritual<\/div><div class=\"exp-list-desc\">Both of you arrive into a space prepared for your session \u2014 ambient, calm, and private. A brief conversation to understand what you each bring that day.<\/div><\/div>\n        <\/li>\n        <li>\n          <div class=\"exp-list-num\">ii.<\/div>\n          <div><div class=\"exp-list-title\">Simultaneous holistic massage<\/div><div class=\"exp-list-desc\">Side by side, each receiving a full-body holistic massage from Mari. Pressure, technique, and focus adapted to each person individually.<\/div><\/div>\n        <\/li>\n        <li>\n          <div class=\"exp-list-num\">iii.<\/div>\n          <div><div class=\"exp-list-title\">Energetic & sensory elements<\/div><div class=\"exp-list-desc\">Aromatic oils, conscious breathing guidance, and intentional energetic touch \u2014 the full holistic experience, shared together.<\/div><\/div>\n        <\/li>\n        <li>\n          <div class=\"exp-list-num\">iv.<\/div>\n          <div><div class=\"exp-list-title\">Close and integration<\/div><div class=\"exp-list-desc\">Time to rest and reconnect after the session in a calm, private setting before you leave.<\/div><\/div>\n        <\/li>\n      <\/ul>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- OPTIONS -->\n<section class=\"options\" id=\"options\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div class=\"label\">Session formats<\/div>\n    <h2 class=\"title\">Choose the <em>depth<\/em> that suits you<\/h2>\n    <div class=\"options-grid\">\n      <div class=\"option-card\">\n        <div class=\"option-name\">Relaxation Duo<\/div>\n        <p class=\"option-desc\">A full-body holistic massage focused on deep physical relaxation and stress release. Ideal for couples who want to decompress together and leave feeling lighter.<\/p>\n        <p class=\"option-desc\" style=\"font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color: var(--rose);\">Best for \u2192 first-time couples \u00b7 stress relief \u00b7 birthdays<\/p>\n        <a href=\"https:\/\/wa.me\/31634366008?text=Hi%20Mari!%20We%27d%20like%20to%20book%20a%20Relaxation%20Duo%20session.%20Could%20you%20send%20us%20a%20quote?\" cla