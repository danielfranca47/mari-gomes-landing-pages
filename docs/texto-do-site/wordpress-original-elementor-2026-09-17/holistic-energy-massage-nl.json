{"content":[{"id":"5a4d237b","settings":[],"elements":[{"id":"3184ac8","settings":{"editor":"<!DOCTYPE html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Holistische Energie Massage Amsterdam | Mari Gomes<\/title>\n<link rel=\"preconnect\" href=\"https:\/\/fonts.googleapis.com\">\n<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n  :root {\n    --cream: #F7F3EE; --warm-white: #FDFAF7; --charcoal: #1C1916;\n    --stone: #6B6460; --gold: #B8924A; --gold-light: #D4B07A;\n    --sage: #7A8C7E; --blush: #D4B5A8; --border: rgba(28,25,22,0.1);\n  }\n  html { scroll-behavior: smooth; }\n  body { font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--charcoal); font-weight: 300; line-height: 1.7; overflow-x: hidden; }\n  nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: 20px 48px; display: flex; align-items: center; justify-content: space-between; background: rgba(247,243,238,0.92); backdrop-filter: blur(12px); border-bottom: 0.5px solid var(--border); }\n  .logo { font-family: 'Cormorant Garamond', serif; font-size: 20px; font-weight: 400; letter-spacing: 0.06em; color: var(--charcoal); text-decoration: none; }\n  .logo span { color: var(--gold); }\n  .nav-cta { font-size: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--charcoal); text-decoration: none; padding: 10px 24px; border: 0.5px solid var(--charcoal); transition: all 0.3s ease; }\n  .nav-cta:hover { background: var(--charcoal); color: var(--cream); }\n  .gtranslate_wrapper { display: flex; align-items: center; gap: 6px; }\n  .gtranslate_wrapper img { display: block; border-radius: 2px; }\n  .nav-left { display: flex; align-items: center; gap: 40px; }\n  .nav-menu { display: flex; align-items: center; gap: 24px; }\n  .nav-menu a { font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--stone); text-decoration: none; transition: color 0.3s ease; }\n  .nav-menu a:hover { color: var(--gold); }\n  .nav-right { display: flex; align-items: center; gap: 24px; }\n  .hero { min-height: 100vh; padding: 120px 48px 80px; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; position: relative; overflow: hidden; }\n  .hero::before { content: ''; position: absolute; top: 0; right: 0; width: 55%; height: 100%; background: #EDE6DC; z-index: 0; }\n  .hero-left { position: relative; z-index: 1; }\n  .hero-eyebrow { font-size: 11px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold); margin-bottom: 24px; display: flex; align-items: center; gap: 12px; }\n  .hero-eyebrow::before { content: ''; width: 32px; height: 0.5px; background: var(--gold); }\n  .hero-headline { font-family: 'Cormorant Garamond', serif; font-size: clamp(40px, 5vw, 62px); font-weight: 300; line-height: 1.15; color: var(--charcoal); margin-bottom: 28px; }\n  .hero-headline em { font-style: italic; color: var(--gold); }\n  .hero-sub { font-size: 16px; font-weight: 300; color: var(--stone); max-width: 420px; margin-bottom: 40px; line-height: 1.8; }\n  .hero-actions { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }\n  .btn-primary { display: inline-block; background: var(--charcoal); color: var(--cream); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; padding: 16px 36px; text-decoration: none; transition: all 0.3s ease; }\n  .btn-primary:hover { background: var(--gold); }\n  .btn-outline { display: inline-block; color: var(--charcoal); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; padding: 16px 36px; border: 0.5px solid var(--charcoal); text-decoration: none; transition: all 0.3s ease; }\n  .btn-outline:hover { background: var(--charcoal); color: var(--cream); }\n  .hero-note { font-size: 12px; color: var(--stone); letter-spacing: 0.04em; }\n  .hero-right { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; }\n  .hero-img-frame { width: 100%; max-width: 420px; aspect-ratio: 3\/4; background: var(--blush); position: relative; overflow: hidden; }\n  .hero-img-frame::after { content: 'MARI GOMES'; position: absolute; bottom: 24px; left: 24px; font-family: 'Cormorant Garamond', serif; font-size: 13px; letter-spacing: 0.2em; color: rgba(28,25,22,0.5); }\n  .hero-badges { position: absolute; bottom: -20px; left: -20px; background: var(--warm-white); border: 0.5px solid var(--border); padding: 20px 24px; }\n  .hero-badges p { font-size: 11px; color: var(--stone); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 4px; }\n  .hero-badges strong { font-size: 22px; font-weight: 400; font-family: 'Cormorant Garamond', serif; }\n  .trust-bar { background: var(--charcoal); color: var(--cream); padding: 24px 48px; display: flex; justify-content: space-around; align-items: center; flex-wrap: wrap; gap: 24px; }\n  .trust-item { text-align: center; }\n  .trust-item strong { display: block; font-family: 'Cormorant Garamond', serif; font-size: 28px; font-weight: 300; }\n  .trust-item span { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.6; }\n  section { padding: 96px 48px; scroll-margin-top: 100px; }\n  .section-label { font-size: 11px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold); margin-bottom: 16px; display: flex; align-items: center; gap: 12px; }\n  .section-label::before { content: ''; width: 24px; height: 0.5px; background: var(--gold); }\n  .section-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(32px, 4vw, 48px); font-weight: 300; line-height: 1.2; margin-bottom: 20px; }\n  .section-title em { font-style: italic; color: var(--gold); }\n  .about { background: var(--warm-white); }\n  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; max-width: 1100px; margin: 0 auto; }\n  .about-img { aspect-ratio: 3\/4; background: #E8DDD4; position: relative; }\n  .about-img::before { content: ''; position: absolute; top: -16px; left: -16px; width: 100%; height: 100%; border: 0.5px solid var(--gold); z-index: -1; }\n  .about-text p { font-size: 16px; color: var(--stone); margin-bottom: 20px; line-height: 1.8; }\n  .about-text p strong { color: var(--charcoal); font-weight: 400; }\n  .about-sig { font-family: 'Cormorant Garamond', serif; font-size: 28px; font-style: italic; color: var(--charcoal); margin-top: 32px; }\n  .therapies { background: var(--cream); }\n  .therapies-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; margin-top: 56px; }\n  .therapy-card { background: var(--warm-white); padding: 40px 32px; border: 0.5px solid var(--border); transition: all 0.3s ease; position: relative; overflow: hidden; }\n  .therapy-card::before { content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 3px; background: var(--gold); transform: scaleX(0); transform-origin: left; transition: transform 0.4s ease; }\n  .therapy-card:hover::before { transform: scaleX(1); }\n  .therapy-card:hover { background: #FBF8F4; }\n  .therapy-num { font-family: 'Cormorant Garamond', serif; font-size: 56px; font-weight: 300; color: rgba(184,146,74,0.2); line-height: 1; margin-bottom: 20px; }\n  .therapy-name { font-family: 'Cormorant Garamond', serif; font-size: 22px; font-weight: 400; margin-bottom: 12px; }\n  .therapy-desc { font-size: 14px; color: var(--stone); line-height: 1.7; }\n  .experience { background: var(--charcoal); color: var(--cream); }\n  .experience .section-label { color: var(--gold-light); }\n  .experience .section-label::before { background: var(--gold-light); }\n  .experience .section-title { color: var(--cream); }\n  .exp-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px; max-width: 900px; margin: 56px auto 0; }\n  .exp-item { padding: 32px; border: 0.5px solid rgba(255,255,255,0.12); display: flex; gap: 20px; align-items: flex-start; }\n  .exp-icon { width: 40px; height: 40px; border-radius: 50%; background: rgba(184,146,74,0.2); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 18px; }\n  .exp-item h4 { font-family: 'Cormorant Garamond', serif; font-size: 18px; font-weight: 400; margin-bottom: 8px; }\n  .exp-item p { font-size: 13px; color: rgba(253,250,247,0.6); line-height: 1.7; }\n  .testimonials { background: var(--cream); }\n  .testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 56px; }\n  .testi-card { background: var(--warm-white); border: 0.5px solid var(--border); padding: 32px; }\n  .testi-stars { color: var(--gold); font-size: 14px; margin-bottom: 16px; letter-spacing: 3px; }\n  .testi-text { font-family: 'Cormorant Garamond', serif; font-size: 17px; font-style: italic; line-height: 1.7; color: var(--charcoal); margin-bottom: 20px; }\n  .testi-name { font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--stone); }\n  .faq { background: var(--warm-white); }\n  .faq-grid { max-width: 720px; margin: 56px auto 0; }\n  .faq-item { border-bottom: 0.5px solid var(--border); padding: 24px 0; }\n  .faq-q { font-family: 'Cormorant Garamond', serif; font-size: 20px; font-weight: 400; color: var(--charcoal); cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; }\n  .faq-q span { font-size: 20px; color: var(--gold); flex-shrink: 0; transition: transform 0.3s; }\n  .faq-a { font-size: 15px; color: var(--stone); line-height: 1.8; padding-top: 16px; display: none; }\n  .faq-item.open .faq-a { display: block; }\n  .faq-item.open .faq-q span { transform: rotate(45deg); }\n  .cta-section { background: #EDE6DC; text-align: center; padding: 96px 48px; }\n  .cta-section .section-title { margin-bottom: 16px; }\n  .cta-section p { font-size: 16px; color: var(--stone); max-width: 480px; margin: 0 auto 40px; line-height: 1.8; }\n  .cta-disclaimer { font-size: 12px; color: var(--stone); margin-top: 20px; opacity: 0.7; }\n  .location { background: var(--cream); }\n  .location-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; max-width: 1100px; margin: 0 auto; }\n  .location-address { font-size: 16px; color: var(--stone); line-height: 1.8; margin-bottom: 28px; }\n  .location-map { aspect-ratio: 4\/3; overflow: hidden; border: 0.5px solid var(--border); }\n  .location-map iframe { width: 100%; height: 100%; display: block; }\n  footer { background: var(--charcoal); color: rgba(253,250,247,0.6); padding: 40px 48px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }\n  footer a { color: inherit; text-decoration: none; font-size: 13px; }\n  footer .logo { color: var(--cream); }\n  @media (max-width: 768px) {\n    nav { padding: 16px 24px; }\n    .nav-menu { display: none; }\n    .hero { grid-template-columns: 1fr; padding: 100px 24px 60px; }\n    .hero::before { width: 100%; top: 55%; height: 50%; }\n    .hero-right { display: none; }\n    section { padding: 64px 24px; }\n    .about-grid, .therapies-grid, .testi-grid, .location-grid { grid-template-columns: 1fr; }\n    .exp-grid { grid-template-columns: 1fr; }\n    .trust-bar { padding: 20px 24px; }\n    footer { padding: 32px 24px; flex-direction: column; text-align: center; }\n  }\n  @keyframes fadeUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }\n  .hero-left > * { opacity: 0; animation: fadeUp 0.8s ease forwards; }\n  .hero-eyebrow { animation-delay: 0.1s; }\n  .hero-headline { animation-delay: 0.25s; }\n  .hero-sub { animation-delay: 0.4s; }\n  .hero-actions { animation-delay: 0.55s; }\n<\/style>\n<\/head>\n<body>\n\n<nav>\n  <div class=\"nav-left\">\n    <a href=\"https:\/\/amarigomes.com\" class=\"logo\">Mari <span>Gomes<\/span><\/a>\n    <div class=\"nav-menu\">\n      <a href=\"#about\">Over mij<\/a>\n      <a href=\"#therapies\">Therapie\u00ebn<\/a>\n      <a href=\"#testimonials\">Reviews<\/a>\n      <a href=\"#faq\">Vragen<\/a>\n      <a href=\"#location\">Locatie<\/a>\n    <\/div>\n  <\/div>\n  <div class=\"nav-right\">\n    <div class=\"gtranslate_wrapper\" id=\"gt-wrapper-52938461\"><\/div>\n    <script>\n      window.gtranslateSettings = window.gtranslateSettings || {};\n      window.gtranslateSettings['52938461'] = {\"default_language\":\"nl\",\"languages\":[\"nl\",\"en\",\"fr\",\"pt\",\"es\"],\"url_structure\":\"none\",\"flag_style\":\"2d\",\"flag_size\":24,\"wrapper_selector\":\"#gt-wrapper-52938461\",\"alt_flags\":[],\"horizontal_position\":\"inline\",\"flags_location\":\"https:\/\/amarigomes.com\/wp-content\/plugins\/gtranslate\/flags\/\"}\n    <\/script>\n    <script src=\"https:\/\/amarigomes.com\/wp-content\/plugins\/gtranslate\/js\/flags.js?ver=7.0\" data-gt-widget-id=\"52938461\"><\/script>\n    <a href=\"https:\/\/wa.me\/31634366008?text=Hoi%20Mari!%20Ik%20ben%20ge%C3%AFnteresseerd%20in%20een%20holistische%20energiemassage.%20Kun%20je%20me%20meer%20informatie%20sturen?\" class=\"nav-cta\" target=\"_blank\">Sessie boeken<\/a>\n  <\/div>\n<\/nav>\n\n<!-- HERO -->\n<section class=\"hero\">\n  <div class=\"hero-left\">\n    <p class=\"hero-eyebrow\">Holistische Massage \u00b7 Amsterdam<\/p>\n    <h1 class=\"hero-headline\">\n      Herstel je <em>energie,<\/em><br>\n      balanceer je chakra's,<br>\n      vind innerlijke rust\n    <\/h1>\n    <p class=\"hero-sub\">\n      Voel je je uitgeput, los van jezelf of uit balans? Onze holistische energiesessies brengen lichaam, geest en levensenergie opnieuw in harmonie \u2014 in een priv\u00e9, professionele studio in Amsterdam.\n    <\/p>\n    <div class=\"hero-actions\">\n      <a href=\"https:\/\/wa.me\/31634366008?text=Hoi%20Mari!%20Ik%20ben%20ge%C3%AFnteresseerd%20in%20een%20holistische%20energiemassage.%20Kun%20je%20me%20meer%20informatie%20en%20beschikbaarheid%20doorgeven?\" class=\"btn-primary\" target=\"_blank\">Vraag je sessie aan \u2192<\/a>\n      <p class=\"hero-note\">Sessies op afspraak \u00b7 Studio in Amsterdam \u00b7 Offerte via WhatsApp<\/p>\n    <\/div>\n  <\/div>\n  <div class=\"hero-right\">\n    <div class=\"hero-img-frame\" style=\"background:transparent;overflow:hidden;\">\n<img src=\"https:\/\/amarigomes.com\/wp-content\/uploads\/2026\/06\/LP1_hero.webp\" alt=\"Mari Gomes, holistisch massagetherapeut, in haar studio in Amsterdam\" style=\"width:100%;height:100%;object-fit:cover;display:block;\">\n      <div class=\"hero-badges\">\n        <p>Holistisch specialist<\/p>\n        <strong>Mari Gomes<\/strong>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- TRUST BAR -->\n<div class=\"trust-bar\">\n  <div class=\"trust-item\"><strong>5\u2605<\/strong><span>Geverifieerde reviews<\/span><\/div>\n  <div class=\"trust-item\"><strong>Studio<\/strong><span>Amsterdam<\/span><\/div>\n  <div class=\"trust-item\"><strong>3<\/strong><span>Therapie modaliteiten<\/span><\/div>\n  <div class=\"trust-item\"><strong>100%<\/strong><span>Persoonlijke aanpak<\/span><\/div>\n<\/div>\n\n<!-- ABOUT PROMISE -->\n<section class=\"about\" id=\"about\">\n  <div class=\"about-grid\">\n    <div class=\"about-img\" style=\"background:transparent;overflow:hidden;min-height:400px;\"><img src=\"https:\/\/amarigomes.com\/wp-content\/uploads\/2026\/06\/LP1_About.webp\" alt=\"Interieur van de priv\u00e9 massagestudio van Mari Gomes in Amsterdam\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\/div>\n    <div class=\"about-text\">\n      <div class=\"section-label\">Waarom Mari Gomes<\/div>\n      <h2 class=\"section-title\">Een sessie die <em>verder gaat<\/em> dan het fysieke<\/h2>\n      <p>De meeste massages verlichten fysieke spanning. <strong>Holistisch energiewerk gaat dieper<\/strong> \u2014 het pakt de energetische oorzaak van die spanning aan: geblokkeerde chakra's, opgeslagen stress, emotionele residuen in het lichaam.<\/p>\n      <p>Mari Gomes is specialist in holistische energietherapie\u00ebn. Elke sessie wordt afgestemd op wat jij die dag meebrengt \u2014 geen vaste scripts, geen standaardaanpak. Alleen nauwkeurig, intentioneel werk op jouw energieveld.<\/p>\n      <p>Sessies vinden plaats in een <strong>priv\u00e9, zorgvuldig ingericht studio in Amsterdam<\/strong> \u2014 een ruimte die is ontworpen voor diepe ontspanning en vertrouwelijk helingswerk.<\/p>\n      <div class=\"about-sig\">Mari Gomes<\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- THERAPIES -->\n<section class=\"therapies\" id=\"therapies\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div class=\"section-label\">Wat we aanbieden<\/div>\n    <h2 class=\"section-title\">Drie paden naar <em>energetisch evenwicht<\/em><\/h2>\n    <div class=\"therapies-grid\">\n      <div class=\"therapy-card\">\n        <div class=\"therapy-num\">01<\/div>\n        <div class=\"therapy-name\">Energetische Helingsmassage<\/div>\n        <p class=\"therapy-desc\">Combineert therapeutische aanraking met energiehelingstechnieken om de natuurlijke energiestroom te herstellen. Ideaal voor het oplossen van emotionele blokkades, het verminderen van angst en het versterken van spirituele verbinding.<\/p>\n      <\/div>\n      <div class=\"therapy-card\">\n        <div class=\"therapy-num\">02<\/div>\n        <div class=\"therapy-name\">Holistische Helingsmassage<\/div>\n        <p class=\"therapy-desc\">Een volledige holistische benadering die tegelijkertijd werkt op fysieke spanning en diepere energielagen. Elke sessie is een uitnodiging om opgestapelde stress achter je te laten en een staat van echte regeneratie te bereiken.<\/p>\n      <\/div>\n      <div class=\"therapy-card\">\n        <div class=\"therapy-num\">03<\/div>\n        <div class=\"therapy-name\">Tantrische Therapie<\/div>\n        <p class=\"therapy-desc\">Geavanceerde energetische deblokkering via bewust contact en ademhaling. Laat diep opgeslagen trauma los, activeert levensenergie opnieuw en cre\u00ebert emotioneel evenwicht. Een diepgaande therapeutische ervaring voor wie naar de kern wil gaan.<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- EXPERIENCE -->\n<section class=\"experience\">\n  <div style=\"max-width: 1100px; margin: 0 auto; text-align: center;\">\n    <div class=\"section-label\" style=\"justify-content: center;\">De ervaring<\/div>\n    <h2 class=\"section-title\" style=\"max-width: 600px; margin: 0 auto 16px;\">Wat er gebeurt <em>tijdens jouw sessie<\/em><\/h2>\n    <p style=\"color: rgba(253,250,247,0.6); max-width: 520px; margin: 0 auto; font-size: 15px;\">Elk element van de sessie is intentioneel. Niets is toevallig.<\/p>\n    <div class=\"exp-grid\">\n      <div class=\"exp-item\">\n        <div class=\"exp-icon\">\u2726<\/div>\n        <div>\n          <h4>Bewuste energetische aanraking<\/h4>\n          <p>Intentionele druk die diepe spieren ontspant en energiebanen deblokkert. Chakra-balancering via nauwkeurige, gekalibreerde aanraking.<\/p>\n        <\/div>\n      <\/div>\n      <div class=\"exp-item\">\n        <div class=\"exp-icon\">\u25c9<\/div>\n        <div>\n          <h4>Begeleide bewuste ademhaling<\/h4>\n          <p>Ademhalingstechnieken die helpen levensenergie te kanaliseren, dagelijkse blokkades los te laten en de staat van aanwezigheid te verdiepen.<\/p>\n        <\/div>\n      <\/div>\n      <div class=\"exp-item\">\n        <div class=\"exp-icon\">\u25c7<\/div>\n        <div>\n          <h4>Ritueel met aromatische oli\u00ebn<\/h4>\n          <p>Therapeutische aroma's die het zintuiglijk bewustzijn versterken, lichaamsontspanning bevorderen en mentale helderheid stimuleren.<\/p>\n        <\/div>\n      <\/div>\n      <div class=\"exp-item\">\n        <div class=\"exp-icon\">\u25cb<\/div>\n        <div>\n          <h4>Gecureerde priv\u00e9 studio<\/h4>\n          <p>Een toegewijde ruimte in Amsterdam voor diep werk \u2014 verlichting, muziek en sfeer afgestemd op volledige onderdompeling.<\/p>\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- TESTIMONIALS -->\n<section class=\"testimonials\" id=\"testimonials\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div class=\"section-label\">Wat cli\u00ebnten zeggen<\/div>\n    <h2 class=\"section-title\">Echte ervaringen,<br><em>echte transformaties<\/em><\/h2>\n    <div class=\"testi-grid\">\n      <div class=\"testi-card\">\n        <div class=\"testi-stars\">\u2605\u2605\u2605\u2605\u2605<\/div>\n        <p class=\"testi-text\">\"De toewijding die ze in haar werk stopt, haar aanwezigheid en de focus die ze gedurende de hele sessie behoudt, zijn buitengewoon.\"<\/p>\n        <p class=\"testi-name\">Fern\u00e3o O.<\/p>\n      <\/div>\n      <div class=\"testi-card\">\n        <div class=\"testi-stars\">\u2605\u2605\u2605\u2605\u2605<\/div>\n        <p class=\"testi-text\">\"Alles, van de inrichting tot het licht en de muziek, was doordacht samengesteld. Ik vertrok ontspannen en verfrist \u2014 als een nieuw mens.\"<\/p>\n        <p class=\"testi-name\">Kinuthia<\/p>\n      <\/div>\n      <div class=\"testi-card\">\n        <div class=\"testi-stars\">\u2605\u2605\u2605\u2605\u2605<\/div>\n        <p class=\"testi-text\">\"Ze laat je zweven met haar ongelooflijke ontspannings- en energiebalanceringstechnieken. De omgeving is professioneel en zeer gastvrij.\"<\/p>\n        <p class=\"testi-name\">Larissa G.<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- FAQ -->\n<section class=\"faq\" id=\"faq\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div class=\"section-label\">Vragen<\/div>\n    <h2 class=\"section-title\">Alles wat je moet weten<br><em>voor je boekt<\/em><\/h2>\n    <div class=\"faq-grid\">\n      <div class=\"faq-item\">\n        <div class=\"faq-q\" onclick=\"toggleFaq(this)\">Wat is het verschil tussen holistische en gewone massage? <span>+<\/span><\/div>\n        <div class=\"faq-a\">Gewone massage richt zich vooral op fysieke spierspanning. Holistische energiemassage werkt tegelijkertijd op fysieke, emotionele en energetische lagen \u2014 niet alleen het symptoom (spanning) maar de oorzaak (blokkade in het energieveld).<\/div>\n      <\/div>\n      <div class=\"faq-item\">\n        <div class=\"faq-q\" onclick=\"toggleFaq(this)\">Zijn er seksuele handelingen bij betrokken? <span>+<\/span><\/div>\n        <div class=\"faq-a\">Nee. Alle sessies zijn strikt therapeutisch en energetisch van aard. De omgeving is professioneel, veilig en te allen tijde respectvol.<\/div>\n      <\/div>\n      <div class=\"faq-item\">\n        <div class=\"faq-q\" onclick=\"toggleFaq(this)\">Hoe werkt de prijsstelling? Kan ik een offerte krijgen? <span>+<\/span><\/div>\n        <div class=\"faq-a\">Sessies worden geprijsd op basis van de gekozen modaliteit en duur. Stuur een bericht via WhatsApp voor een persoonlijke offerte met alle details \u2014 Mari reageert snel met alle informatie die je nodig hebt.<\/div>\n      <\/div>\n      <div class=\"faq-item\">\n        <div class=\"faq-q\" onclick=\"toggleFaq(this)\">Waar vinden de sessies plaats? <span>+<\/span><\/div>\n        <div class=\"faq-a\">Alle sessies vinden plaats in Mari's priv\u00e9 studio in Amsterdam. Het adres en de exacte routebeschrijving worden gedeeld na bevestiging van de boeking.<\/div>\n      <\/div>\n      <div class=\"faq-item\">\n        <div class=\"faq-q\" onclick=\"toggleFaq(this)\">Wat moet ik dragen? <span>+<\/span><\/div>\n        <div class=\"faq-a\">Draag comfortabele, makkelijk uit te trekken kleding zoals een losse broek en een eenvoudig shirt. Kom indien mogelijk al gedoucht \u2014 er is ook een douche beschikbaar in de studio.<\/div>\n      <\/div>\n      <div class=\"faq-item\">\n        <div class=\"faq-q\" onclick=\"toggleFaq(this)\">Zijn er contra-indicaties? <span>+<\/span><\/div>\n        <div class=\"faq-a\">Sessies worden afgeraden bij koorts, diepe veneuze trombose, fracturen, ernstige osteoporose, open wonden of een hoog-risicozwangerschap. Vermeld eventuele gezondheidsproblemen bij het boeken.<\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- LOCATION -->\n<section class=\"location\" id=\"location\">\n  <div class=\"location-grid\">\n    <div>\n      <div class=\"section-label\">Bezoek ons<\/div>\n      <h2 class=\"section-title\">Vind onze <em>studio<\/em> in Amsterdam<\/h2>\n      <p class=\"location-address\">Brouwersgracht 270A<br>1013 HG Amsterdam<br>Nederland<\/p>\n      <a href=\"https:\/\/www.google.com\/maps\/dir\/Massagem+Amsterdam+-Mari+Gomes,+Brouwersgracht+270A,+1013+HG+Amsterdam,+Pa\u00edses+Baixos\/Massagem+Amsterdam+-Mari+Gomes,+Brouwersgracht+270A,+1013+HG+Amsterdam,+Pa\u00edses+Baixos\/@37.0311168,-7.8446592,14z\/data=!3m1!4b1!4m13!4m12!1m5!1m1!1s0x47c6095d24b054c5:0x1f0bbf12412e2877!2m2!1d4.8849098!2d52.3828845!1m5!1m1!1s0x47c6095d24b054c5:0x1f0bbf12412e2877!2m2!1d4.8849098!2d52.3828845?entry=ttu&amp;g_ep=EgoyMDI2MDYyNC4wIKXMDSoASAFQAw%3D%3D\" class=\"btn-outline\" style=\"margin-left:0;\" target=\"_blank\">Routebeschrijving \u2192<\/a>\n    <\/div>\n    <div class=\"location-map\">\n      <iframe src=\"https:\/\/maps.google.com\/maps?q=Massagem+Amsterdam+-+Mari+Gomes%2C+Brouwersgracht+270A%2C+1013+HG+Amsterdam&output=embed\" width=\"100%\" height=\"100%\" style=\"border:0;\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" title=\"Locatie van de studio van Mari Gomes op Google Maps\"><\/iframe>\n    <\/div>\n  <\/div>\n<\/section>\n\n<!-- CTA SECTION -->\n<section class=\"cta-section\">\n  <div class=\"section-label\" style=\"justify-content: center;\">Klaar om te beginnen<\/div>\n  <h2 class=\"section-title\">Jouw energie <em>verdient<\/e