{"content":[{"id":"72daa4b","settings":[],"elements":[{"id":"5fdd2b0d","settings":{"editor":"<!DOCTYPE html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Koppelsmassage Amsterdam | Holistische Ervaring voor Twee | Mari Gomes<\/title>\n<link rel=\"preconnect\" href=\"https:\/\/fonts.googleapis.com\">\n<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Jost:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n  :root { --ivory: #F8F4EF; --white: #FEFCFA; --ink: #1E1A17; --warm-gray: #7C746E; --rose: #9B5E52; --rose-light: #C4897E; --blush: #EDD9D3; --gold: #A87B4A; --border: rgba(30,26,23,0.09); }\n  html { scroll-behavior: smooth; }\n  body { font-family: 'Jost', sans-serif; background: var(--ivory); color: var(--ink); font-weight: 300; line-height: 1.7; overflow-x: hidden; }\n  nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: 20px 48px; display: flex; align-items: center; justify-content: space-between; background: rgba(248,244,239,0.93); backdrop-filter: blur(12px); border-bottom: 0.5px solid var(--border); }\n  .logo { font-family: 'Libre Baskerville', serif; font-size: 18px; font-weight: 400; color: var(--ink); text-decoration: none; letter-spacing: 0.04em; }\n  .logo span { color: var(--rose); }\n  .nav-cta { font-size: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--white); background: var(--rose); text-decoration: none; padding: 10px 24px; transition: background 0.3s; }\n  .nav-cta:hover { background: var(--ink); }\n  .gtranslate_wrapper { display: flex; align-items: center; gap: 6px; }\n  .gtranslate_wrapper img { display: block; border-radius: 2px; }\n  .nav-left { display: flex; align-items: center; gap: 40px; }\n  .nav-menu { display: flex; align-items: center; gap: 22px; }\n  .nav-menu a { font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--warm-gray); text-decoration: none; transition: color 0.3s ease; }\n  .nav-menu a:hover { color: var(--rose); }\n  .nav-right { display: flex; align-items: center; gap: 22px; }\n  .hero { min-height: 100vh; display: grid; grid-template-columns: 1fr 1fr; padding-top: 80px; background: var(--ivory); }\n  .hero-left { background: var(--blush); display: flex; align-items: flex-end; padding: 64px 48px; min-height: 560px; position: relative; overflow: hidden; }\n  .hero-left::before { content: '\u2767'; position: absolute; top: 40px; left: 48px; font-size: 48px; color: rgba(155,94,82,0.2); }\n  .hero-number { font-family: 'Libre Baskerville', serif; font-size: 180px; font-weight: 400; color: rgba(155,94,82,0.1); position: absolute; top: 20px; right: -10px; line-height: 1; user-select: none; }\n  .hero-left-content { position: relative; z-index: 1; }\n  .hero-tag { font-size: 11px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--rose); margin-bottom: 16px; display: flex; align-items: center; gap: 10px; }\n  .hero-tag::before { content: ''; width: 20px; height: 0.5px; background: var(--rose); }\n  .hero-pull { font-family: 'Libre Baskerville', serif; font-size: clamp(26px, 3.2vw, 42px); font-weight: 400; font-style: italic; line-height: 1.3; color: var(--ink); }\n  .hero-right { display: flex; flex-direction: column; justify-content: center; padding: 80px 64px 64px 56px; }\n  .hero-eyebrow { font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--rose); margin-bottom: 20px; }\n  .hero-headline { font-family: 'Libre Baskerville', serif; font-size: clamp(32px, 3.5vw, 50px); font-weight: 400; line-height: 1.2; color: var(--ink); margin-bottom: 24px; }\n  .hero-headline em { font-style: italic; color: var(--rose); }\n  .hero-sub { font-size: 16px; color: var(--warm-gray); max-width: 400px; margin-bottom: 36px; line-height: 1.8; }\n  .btn-rose { display: inline-block; background: var(--rose); color: var(--white); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; padding: 16px 36px; text-decoration: none; transition: background 0.3s; }\n  .btn-rose:hover { background: var(--ink); }\n  .btn-outline { display: inline-block; background: transparent; color: var(--rose); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; padding: 15px 34px; border: 1px solid var(--rose); text-decoration: none; transition: all 0.3s; }\n  .btn-outline:hover { background: var(--rose); color: var(--white); }\n  .location { background: var(--blush); }\n  .location-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; max-width: 1100px; margin: 0 auto; }\n  .location-address { font-size: 16px; color: var(--warm-gray); line-height: 1.8; margin-bottom: 28px; }\n  .location-map { aspect-ratio: 4\/3; overflow: hidden; border: 0.5px solid var(--border); }\n  .location-map iframe { width: 100%; height: 100%; display: block; }\n  .hero-note { font-size: 12px; color: var(--warm-gray); margin-top: 12px; }\n  .promise-bar { background: var(--ink); color: var(--ivory); padding: 28px 48px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; }\n  .promise-item { padding: 0 32px; text-align: center; border-right: 0.5px solid rgba(255,255,255,0.1); }\n  .promise-item:last-child { border-right: none; }\n  .promise-icon { font-size: 22px; margin-bottom: 8px; }\n  .promise-title { font-family: 'Libre Baskerville', serif; font-size: 16px; font-weight: 400; margin-bottom: 4px; }\n  .promise-desc { font-size: 12px; color: rgba(248,244,239,0.55); line-height: 1.5; }\n  section { padding: 96px 48px; scroll-margin-top: 100px; }\n  .label { font-size: 11px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--rose); margin-bottom: 14px; display: flex; align-items: center; gap: 10px; }\n  .label::before { content: ''; width: 20px; height: 0.5px; background: var(--rose); }\n  .title { font-family: 'Libre Baskerville', serif; font-size: clamp(28px, 3.5vw, 44px); font-weight: 400; line-height: 1.25; margin-bottom: 20px; }\n  .title em { font-style: italic; color: var(--rose); }\n  .for-whom { background: var(--white); }\n  .for-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 56px; }\n  .for-card { padding: 36px 28px; border: 0.5px solid var(--border); background: var(--ivory); }\n  .for-card-icon { font-size: 28px; margin-bottom: 20px; }\n  .for-card h3 { font-family: 'Libre Baskerville', serif; font-size: 19px; font-weight: 400; margin-bottom: 12px; color: var(--ink); }\n  .for-card p { font-size: 14px; color: var(--warm-gray); line-height: 1.7; }\n  .experience-section { background: var(--blush); }\n  .exp-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; max-width: 1100px; margin: 0 auto; }\n  .exp-visual { background: var(--ivory); aspect-ratio: 1; display: flex; align-items: center; justify-content: center; position: relative; border: 0.5px solid var(--border); }\n  .exp-visual-inner { text-align: center; padding: 40px; }\n  .exp-visual-inner .big { font-family: 'Libre Baskerville', serif; font-size: 80px; font-weight: 400; font-style: italic; color: var(--rose); line-height: 1; }\n  .exp-visual-inner p { font-size: 13px; color: var(--warm-gray); margin-top: 12px; letter-spacing: 0.08em; text-transform: uppercase; }\n  .exp-list { list-style: none; }\n  .exp-list li { padding: 18px 0; border-bottom: 0.5px solid rgba(30,26,23,0.1); display: flex; gap: 16px; align-items: flex-start; }\n  .exp-list li:last-child { border-bottom: none; }\n  .exp-list-num { font-family: 'Libre Baskerville', serif; font-size: 13px; font-style: italic; color: var(--rose); flex-shrink: 0; width: 24px; }\n  .exp-list-title { font-size: 15px; font-weight: 400; margin-bottom: 4px; }\n  .exp-list-desc { font-size: 13px; color: var(--warm-gray); line-height: 1.6; }\n  .options { background: var(--white); }\n  .options-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; margin-top: 56px; }\n  .option-card { background: var(--ivory); padding: 36px 28px; border: 0.5px solid var(--border); position: relative; }\n  .option-popular { position: absolute; top: 0; left: 0; right: 0; background: var(--rose); color: var(--white); font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; text-align: center; padding: 6px; }\n  .option-card.featured { margin-top: -1px; border-color: var(--rose); }\n  .option-name { font-family: 'Libre Baskerville', serif; font-size: 20px; font-weight: 400; margin: 12px 0; }\n  .option-desc { font-size: 13px; color: var(--warm-gray); line-height: 1.7; margin-bottom: 16px; }\n  .option-cta { font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--rose); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }\n  .option-cta:hover { color: var(--ink); }\n  .testimonials { background: var(--ivory); }\n  .testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 56px; }\n  .testi-card { background: var(--white); border: 0.5px solid var(--border); padding: 32px; position: relative; }\n  .testi-card::before { content: '\"'; font-family: 'Libre Baskerville', serif; font-size: 64px; font-style: italic; color: var(--blush); position: absolute; top: 16px; left: 24px; line-height: 1; }\n  .testi-text { font-family: 'Libre Baskerville', serif; font-size: 15px; font-style: italic; line-height: 1.75; color: var(--ink); margin-bottom: 20px; padding-top: 36px; }\n  .testi-name { font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--warm-gray); }\n  .testi-stars { color: var(--gold); font-size: 12px; letter-spacing: 3px; margin-bottom: 4px; }\n  .faq { background: var(--white); }\n  .faq-inner { max-width: 680px; margin: 56px auto 0; }\n  .faq-item { border-bottom: 0.5px solid var(--border); padding: 22px 0; }\n  .faq-q { font-family: 'Libre Baskerville', serif; font-size: 18px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; color: var(--ink); }\n  .faq-q span { color: var(--rose); font-size: 22px; flex-shrink: 0; transition: transform 0.3s; }\n  .faq-a { font-size: 14px; color: var(--warm-gray); line-height: 1.8; padding-top: 14px; display: none; }\n  .faq-item.open .faq-a { display: block; }\n  .faq-item.open .faq-q span { transform: rotate(45deg); }\n  .cta-final { background: var(--rose); color: var(--white); text-align: center; padding: 96px 48px; position: relative; overflow: hidden; }\n  .cta-final::before { content: '\u2767'; position: absolute; font-size: 300px; color: rgba(255,255,255,0.04); top: -60px; right: -40px; font-family: serif; user-select: none; }\n  .cta-final .label { justify-content: center; color: rgba(248,244,239,0.65); }\n  .cta-final .label::before { background: rgba(248,244,239,0.4); }\n  .cta-final .title { color: var(--white); margin-bottom: 16px; }\n  .cta-final p { font-size: 16px; color: rgba(248,244,239,0.78); max-width: 460px; margin: 0 auto 40px; line-height: 1.8; }\n  .btn-ivory { display: inline-block; background: var(--ivory); color: var(--rose); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; padding: 16px 40px; text-decoration: none; transition: all 0.3s; }\n  .btn-ivory:hover { background: var(--ink); color: var(--ivory); }\n  .cta-note { font-size: 12px; color: rgba(248,244,239,0.5); margin-top: 16px; }\n  footer { background: var(--ink); color: rgba(248,244,239,0.5); padding: 36px 48px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }\n  footer a { color: inherit; text-decoration: none; font-size: 13px; }\n  footer .logo { color: var(--ivory); }\n  @media (max-width: 768px) {\n    nav { padding: 16px 24px; }\n    .nav-menu { display: none; }\n    .hero { grid-template-columns: 1fr; }\n    .hero-left { min-height: 220px; padding: 40px 24px; }\n    .hero-number { display: none; }\n    .hero-right { padding: 48px 24px; }\n    section { padding: 64px 24px; }\n    .promise-bar { grid-template-columns: 1fr; gap: 20px; padding: 32px 24px; }\n    .promise-item { border-right: none; border-bottom: 0.5px solid rgba(255,255,255,0.1); padding-bottom: 20px; }\n    .for-grid, .options-grid, .testi-grid, .location-grid { grid-template-columns: 1fr; }\n    .exp-layout { grid-template-columns: 1fr; }\n    .exp-visual { display: none; }\n    footer { flex-direction: column; text-align: center; padding: 28px 24px; }\n  }\n  @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }\n  .hero-eyebrow { opacity: 0; animation: fadeUp 0.7s ease 0.1s forwards; }\n  .hero-headline { opacity: 0; animation: fadeUp 0.7s ease 0.25s forwards; }\n  .hero-sub { opacity: 0; animation: fadeUp 0.7s ease 0.4s forwards; }\n  .btn-rose, .hero-note { opacity: 0; animation: fadeUp 0.7s ease 0.55s forwards; }\n<\/style>\n<\/head>\n<body>\n\n<nav>\n  <div class=\"nav-left\">\n    <a href=\"https:\/\/amarigomes.com\" class=\"logo\">Mari <span>Gomes<\/span><\/a>\n    <div class=\"nav-menu\">\n      <a href=\"#experience-section\">Ervaring<\/a>\n      <a href=\"#options\">Pakketten<\/a>\n      <a href=\"#testimonials\">Reviews<\/a>\n      <a href=\"#faq\">Vragen<\/a>\n      <a href=\"#location\">Locatie<\/a>\n    <\/div>\n  <\/div>\n  <div class=\"nav-right\">\n    <div class=\"gtranslate_wrapper\" id=\"gt-wrapper-96138475\"><\/div>\n    <script>\n      window.gtranslateSettings = window.gtranslateSettings || {};\n      window.gtranslateSettings['96138475'] = {\"default_language\":\"nl\",\"languages\":[\"nl\",\"en\",\"fr\",\"pt\",\"es\"],\"url_structure\":\"none\",\"flag_style\":\"2d\",\"flag_size\":24,\"wrapper_selector\":\"#gt-wrapper-96138475\",\"alt_flags\":[],\"horizontal_position\":\"inline\",\"flags_location\":\"https:\/\/amarigomes.com\/wp-content\/plugins\/gtranslate\/flags\/\"}\n    <\/script>\n    <script src=\"https:\/\/amarigomes.com\/wp-content\/plugins\/gtranslate\/js\/flags.js?ver=7.0\" data-gt-widget-id=\"96138475\"><\/script>\n    <a href=\"https:\/\/wa.me\/31634366008?text=Hoi%20Mari!%20Mijn%20partner%20en%20ik%20zijn%20ge%C3%AFnteresseerd%20in%20een%20koppelsmassage.%20Kun%20je%20ons%20meer%20informatie%20en%20een%20offerte%20sturen?\" class=\"nav-cta\" target=\"_blank\">Boek voor twee<\/a>\n  <\/div>\n<\/nav>\n\n<div class=\"hero\">\n  <div class=\"hero-left\" style=\"background:transparent;position:relative;overflow:hidden;\">\n    <div style=\"position:absolute;inset:0;z-index:0;\"><img src=\"https:\/\/amarigomes.com\/wp-content\/uploads\/2026\/06\/LP3_Hero.webp\" alt=\"Stel dat samen ontspant na een massage-sessie in de studio van Mari Gomes\" style=\"width:100%;height:100%;object-fit:cover;display:block;\"><\/div>\n  <div class=\"hero-number\" style=\"z-index:1;position:relative;\">2<\/div>\n    <div class=\"hero-left-content\" style=\"position:relative;z-index:2;background:rgba(237,217,211,0.55);padding:20px;border-radius:4px;\">\n      <p class=\"hero-tag\">Koppelsmassage<\/p>\n      <p class=\"hero-pull\">\"Een ervaring<br>die je deelt \u2014<br>en allebei voelt.\"<\/p>\n    <\/div>\n  <\/div>\n  <div class=\"hero-right\">\n    <p class=\"hero-eyebrow\">Amsterdam \u00b7 Priv\u00e9 Studio \u00b7 Voor twee<\/p>\n    <h1 class=\"hero-headline\">Een holistische<br>massage-ervaring<br><em>voor koppels<\/em><\/h1>\n    <p class=\"hero-sub\">Meer dan een massage \u2014 een gedeelde reis die stress verlicht, energie herstelt en verbinding verdiept. In een priv\u00e9, zorgvuldig ingericht studio in Amsterdam.<\/p>\n    <a href=\"https:\/\/wa.me\/31634366008?text=Hoi%20Mari!%20Mijn%20partner%20en%20ik%20zijn%20ge%C3%AFnteresseerd%20in%20een%20koppelsmassage.%20Kun%20je%20ons%20een%20offerte%20en%20beschikbaarheid%20sturen?\" class=\"btn-rose\" target=\"_blank\">Vraag je offerte voor twee aan \u2192<\/a>\n    <p class=\"hero-note\">Priv\u00e9 studio \u00b7 Op afspraak \u00b7 Offerte via WhatsApp<\/p>\n  <\/div>\n<\/div>\n\n<div class=\"promise-bar\">\n  <div class=\"promise-item\"><div class=\"promise-icon\">\u25c8<\/div><div class=\"promise-title\">Naast elkaar<\/div><p class=\"promise-desc\">Beleef de sessie samen, in dezelfde ruimte, op hetzelfde moment.<\/p><\/div>\n  <div class=\"promise-item\"><div class=\"promise-icon\">\u25ce<\/div><div class=\"promise-title\">Op maat voor twee<\/div><p class=\"promise-desc\">Elke sessie wordt gepersonaliseerd op wat jullie die dag meebrengen.<\/p><\/div>\n  <div class=\"promise-item\"><div class=\"promise-icon\">\u25c7<\/div><div class=\"promise-title\">Priv\u00e9 studio<\/div><p class=\"promise-desc\">Een intieme, toegewijde ruimte in Amsterdam ontworpen voor koppels.<\/p><\/div>\n<\/div>\n\n<section class=\"for-whom\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div class=\"label\">Deze sessie is voor jullie als...<\/div>\n    <h2 class=\"title\">Gemaakt voor elk <em>soort koppel<\/em><\/h2>\n    <div class=\"for-grid\">\n      <div class=\"for-card\"><div class=\"for-card-icon\">\u25c8<\/div><h3>Jullie willen herverbinden<\/h3><p>Drukke levens cre\u00ebren afstand. Een gezamenlijke sessie vertraagt alles en cre\u00ebert ruimte voor echte aanwezigheid \u2014 samen, zonder afleiding.<\/p><\/div>\n      <div class=\"for-card\"><div class=\"for-card-icon\">\u25ce<\/div><h3>Jullie iets anders willen<\/h3><p>Een unieke ervaring die verder gaat dan een diner. Iets wat jullie allebei bijblijft. Een cadeau dat op een dieper niveau geeft.<\/p><\/div>\n      <div class=\"for-card\"><div class=\"for-card-icon\">\u25c7<\/div><h3>Jullie allebei stress dragen<\/h3><p>Wanneer beide partners gestrest zijn, lijdt de relatie eronder. Samen ontspannen \u2014 in dezelfde ruimte, op hetzelfde moment \u2014 cre\u00ebert een gedeelde reset.<\/p><\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<section class=\"experience-section\" id=\"experience-section\">\n  <div class=\"exp-layout\">\n    <div class=\"exp-visual\" style=\"background:transparent;overflow:hidden;\"><img src=\"https:\/\/amarigomes.com\/wp-content\/uploads\/2026\/06\/LP3_Experience.webp\" alt=\"Sfeer van de behandelkamer ingericht voor een koppelsessie in de studio van Mari Gomes\" style=\"width:100%;height:100%;object-fit:cover;display:block;\">\n      <div class=\"exp-visual-inner\" style=\"display:none;\"><div class=\"big\">voor<br>twee<\/div><p>Amsterdam \u00b7 Studio \u00b7 Priv\u00e9<\/p><\/div><\/div>\n    <div>\n      <div class=\"label\">Wat er in jullie sessie gebeurt<\/div>\n      <h2 class=\"title\">Elk detail <em>intentioneel<\/em><\/h2>\n      <ul class=\"exp-list\">\n        <li><div class=\"exp-list-num\">i.<\/div><div><div class=\"exp-list-title\">Verwelkomingsritueel<\/div><div class=\"exp-list-desc\">Jullie komen allebei aan in een ruimte die is voorbereid voor jullie sessie \u2014 rustgevend, sfeervol en priv\u00e9. Een korte intake om te begrijpen wat jullie die dag meebrengen.<\/div><\/div><\/li>\n        <li><div class=\"exp-list-num\">ii.<\/div><div><div class=\"exp-list-title\">Gelijktijdige holistische massage<\/div><div class=\"exp-list-desc\">Naast elkaar, elk een full-body holistische massage ontvangend van Mari. Druk, techniek en focus individueel aangepast aan elke partner.<\/div><\/div><\/li>\n        <li><div class=\"exp-list-num\">iii.<\/div><div><div class=\"exp-list-title\">Energetische en zintuiglijke elementen<\/div><div class=\"exp-list-desc\">Aromatische oli\u00ebn, begeleide ademhaling en intentionele energetische aanraking \u2014 de volledige holistische ervaring, samen gedeeld.<\/div><\/div><\/li>\n        <li><div class=\"exp-list-num\">iv.<\/div><div><div class=\"exp-list-title\">Afsluiting en integratie<\/div><div class=\"exp-list-desc\">Tijd om na de sessie te rusten en te herverbinden in een rustige, priv\u00e9 omgeving voordat jullie vertrekken.<\/div><\/div><\/li>\n      <\/ul>\n    <\/div>\n  <\/div>\n<\/section>\n\n<section class=\"options\" id=\"options\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div class=\"label\">Sessieformaten<\/div>\n    <h2 class=\"title\">Kies de <em>diepte<\/em> die bij jullie past<\/h2>\n    <div class=\"options-grid\">\n      <div class=\"option-card\">\n        <div class=\"option-name\">Ontspanning Duo<\/div>\n        <p class=\"option-desc\">Een full-body holistische massage gericht op diepe fysieke ontspanning en stressverlichting. Ideaal voor koppels die samen willen ontspannen en lichter willen vertrekken.<\/p>\n        <p class=\"option-desc\" style=\"font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color: var(--rose);\">Beste voor \u2192 eerste keer \u00b7 stressverlichting \u00b7 verjaardag<\/p>\n        <a href=\"https:\/\/wa.me\/31634366008?text=Hoi%20Mari!%20We%20willen%20graag%20een%20Ontspanning%20Duo%20sessie%20boeken.%20Kun%20je%20ons%20een%20offerte%20sturen?\" class=\"option-cta\" target=\"_blank\">Offerte aanvragen \u2192<\/a>\n      <\/div>\n      <div class=\"option-card featured\">\n        <div class=\"option-popular\">Meest gevraagd<\/div>\n        <div class=\"option-name\">Holistische Koppelservaring<\/div>\n        <p class=\"option-desc\">Onze signatuursessie voor twee \u2014 combineert fysieke massage, energetische heling en bewuste elementen. Elk partner ontvangt een volledig gepersonaliseerde sessie terwijl jullie de ervaring samen delen.<\/p>\n        <p class=\"option-desc\" style=\"font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color: var(--rose);\">Beste voor \u2192 herverbinding \u00b7 jubileum \u00b7 diepe reset<\/p>\n        <a href=\"https:\/\/wa.me\/31634366008?text=Hoi%20Mari!%20We%20zijn%20ge%C3%AFnteresseerd%20in%20de%20Holistische%20Koppelservaring.%20Kun%20je%20ons%20details%20en%20een%20offerte%20sturen?\" class=\"option-cta\" target=\"_blank\">Offerte aanvragen \u2192<\/a>\n      <\/div>\n      <div class=\"option-card\">\n        <div class=\"option-name\">Tantrische Koppelstherapie<\/div>\n        <p class=\"option-desc\">Een diepere energetische ervaring voor koppels die klaar zijn om samen verbinding, levensenergie en emotionele vrijlating te verkennen. Een transformerende sessie die echte vernieuwing brengt.<\/p>\n        <p class=\"option-desc\" style=\"font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color: var(--rose);\">Beste voor \u2192 diepere verbinding \u00b7 energiewerk \u00b7 vernieuwing<\/p>\n        <a href=\"https:\/\/wa.me\/31634366008?text=Hoi%20Mari!%20We%20zijn%20ge%C3%AFnteresseerd%20in%20de%20Tantrische%20Koppelstherapie.%20Kun%20je%20ons%20meer%20informatie%20sturen?\" class=\"option-cta\" target=\"_blank\">Offerte aanvragen \u2192<\/a>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<section class=\"testimonials\" id=\"testimonials\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div class=\"label\">Wat cli\u00ebnten zeggen<\/div>\n    <h2 class=\"title\">Ervaringen die<br><em>bijblijven<\/em><\/h2>\n    <div class=\"testi-grid\">\n      <div class=\"testi-card\"><div class=\"testi-stars\">\u2605\u2605\u2605\u2605\u2605<\/div><p class=\"testi-text\">De therapeut was zeer vriendelijk en hartelijk. Alles \u2014 van de inrichting tot het licht en de muziek \u2014 was doordacht samengesteld. We vertrokken ontspannen en verfrist. Onvergetelijk.<\/p><p class=\"testi-name\">Kinuthia<\/p><\/div>\n      <div class=\"testi-card\"><div class=\"testi-stars\">\u2605\u2605\u2605\u2605\u2605<\/div><p class=\"testi-text\">Ze laat je zweven. Haar ongelooflijke techniek en warmte cre\u00ebren een omgeving die zowel professioneel als diep gastvrij is. We komen zeker terug.<\/p><p class=\"testi-name\">Larissa G.<\/p><\/div>\n      <div class=\"testi-card\"><div class=\"testi-stars\">\u2605\u2605\u2605\u2605\u2605<\/div><p class=\"testi-text\">De toewijding die ze in haar werk stopt is buitengewoon. Je voelt je volledig verzorgd vanaf het moment dat je binnenkomt. Een ervaring die we elk koppel aanraden.<\/p><p class=\"testi-name\">Fern\u00e3o O.<\/p><\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<section class=\"faq\" id=\"faq\">\n  <div style=\"max-width: 1100px; margin: 0 auto;\">\n    <div class=\"label\">Jullie vragen, beantwoord<\/div>\n    <h2 class=\"title\">Alles wat je moet weten<br><em>voor je boekt<\/em><\/h2>\n    <div class=\"faq-inner\">\n      <div class=\"faq-item\"><div class=\"faq-q\" onclick=\"toggleFaq(this)\">Ontvangen we de massage tegelijkertijd?<span>+<\/span><\/div><div class=\"faq-a\">Ja. Beide partners ontvangen hun massage gelijktijdig in dezelfde priv\u00e9 ruimte. Jullie beleven het samen, naast elkaar.<\/div><\/div>\n      <div class=\"faq-item\"><div class=\"faq-q\" onclick=\"toggleFaq(this)\">Is er \u00e9\u00e9n of zijn er twee therapeuten?<span>+<\/span><\/div><div class=\"faq-a\">Mari adviseert over het beste formaat voor de gekozen sessie wanneer jullie contact opnemen. Dit wordt v\u00f3\u00f3r de boeking verduidelijkt samen met de offerte.<\/div><\/div>\n      <div class=\"faq-item\"><div class=\"faq-q\" onclick=\"toggleFaq(this)\">Hoe krijgen we een offerte?<span>+<\/span><\/div><div class=\"faq-a\">Stuur een WhatsApp-bericht met het gewenste sessietype. Mari antwoordt met een persoonlijke offerte, alle details en beschikbare datums \u2014 meestal snel.<\/div><\/div>\n      <div class=\"faq-item\"><div class=\"faq-q\" onclick=\"toggleFaq(this)\">Waar vindt de sessie plaats?<span>+<\/span><\/div><div class=\"faq-a\">Alle sessies vinden plaats in een priv\u00e9 studio in Amsterdam. Het exacte adres wordt gedeeld na bevestiging van de boeking.<\/div><\/div>\n      <div class=\"faq-item\"><div class=\"faq-q\" onclick=\"toggleFaq(this)\">Is dit een seksuele dienst?<span>+<\/span><\/div><div class=\"faq-a\">Nee. Alle sessies \u2014 inclusief Tantrische Therapie \u2014 zijn strikt therapeutisch en energetisch van aard. De studio is professioneel en te allen tijde volledig respectvol.<\/div><\/div>\n      <div class=\"faq-item\"><div class=\"faq-q\" onclick=\"toggleFaq(this)\">Kunnen we dit cadeau geven?<span>+<\/span><\/div><div class=\"faq-a\">Ja. Een koppelssessie is een doordacht en betekenisvol cadeau. Neem contact op via WhatsApp en Mari adviseert over de beste optie voor de gelegenheid.<\/div><\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<section class=\"location\" id=\"location\">\n  <div class=\"location-grid\">\n    <div>\n      <div class=\"label\">Bezoek ons<\/div>\n      <h2 class=\"title\">Vind onze <em>studio<\/em> in Amsterdam<\/h2>\n      <p class=\"location-address\">Brouwersgracht 270A<br>1013 HG Amsterdam<br>Nederland<\/p>\n      <a href=\"https:\/\/www.google.com\/maps\/dir\/Massagem+Amsterdam+-Mari+Gomes,+Brouwersgracht+270A,+1013+HG+Amsterdam,+Pa\u00edses+Baixos\/Massagem+Amsterdam+-Mari+Gomes,+Brouwersgracht+270A,+1013+HG+Amsterdam,+Pa\u00edses+Baixos\/@37.0311168,-7.8446592,14z\/data=!3m1!4b1!4m13!4m12!1m5!1m1!1s0x47c6095d24b054c5:0x1f0bbf12412e2877!2m2!1d4.8849098!2d52.3828845!1m5!1m1!1s0x47c6095d24b054c5:0x1f0bbf12412e2877!2m2!1d4.8849098!2d52.3828845?entry=ttu&amp;g_ep=EgoyMDI2MDYyNC4wIKXMDSoASAFQAw%3D%3D\" class=\"btn-outline\" target=\"_blank\">Routebeschrijving \u2192<\/a>\n    <\/div>\n    <div class=\"location-map\">\n      <iframe src=\"https:\/\/maps.google.com\/maps?q=Massagem+Amsterdam+-+Mari+Gomes%2C+Brouwersgracht+270A%2C+1013+HG+Amsterdam&output=embed\" width=\"100%\" height=\"100%\" style=\"border:0;\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" title=\"Locatie van de studio van Mari Gomes op Google Maps\"><\/iframe>\n    <\/div>\n  <\/div>\n<\/section>\n\n<section class=\"cta-final\">\n  <div class=\"label\">Boek jullie ervaring<\/div>\n  <h2 class=\"title\">Gun jullie zel